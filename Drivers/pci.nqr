module os.drivers.pci

import "../Arch/x86_64/api.nqr"

function pci_config_address(bus: u32, slot: u32, fn: u32, offset: u32): u32 {
    let aligned: u32 = offset - (offset % (4 as u32))
    return (2147483648 as u32) + (bus * (65536 as u32)) + (slot * (2048 as u32)) + (fn * (256 as u32)) + aligned
}

function pci_read32(bus: u32, slot: u32, fn: u32, offset: u32): u32 {
    arch_out32(3320 as u16, pci_config_address(bus, slot, fn, offset))
    return arch_in32(3324 as u16)
}

function pci_write32(bus: u32, slot: u32, fn: u32, offset: u32, value: u32): void {
    arch_out32(3320 as u16, pci_config_address(bus, slot, fn, offset))
    arch_out32(3324 as u16, value)
}

function pci_read16(bus: u32, slot: u32, fn: u32, offset: u32): u16 {
    arch_out32(3320 as u16, pci_config_address(bus, slot, fn, offset))
    let port: u16 = (3324 + (offset % (4 as u32))) as u16
    return arch_in16(port)
}

function pci_write16(bus: u32, slot: u32, fn: u32, offset: u32, value: u16): void {
    arch_out32(3320 as u16, pci_config_address(bus, slot, fn, offset))
    let port: u16 = (3324 + (offset % (4 as u32))) as u16
    arch_out16(port, value)
}

function pci_read8(bus: u32, slot: u32, fn: u32, offset: u32): u8 {
    arch_out32(3320 as u16, pci_config_address(bus, slot, fn, offset))
    let port: u16 = (3324 + (offset % (4 as u32))) as u16
    return arch_in8(port)
}

function pci_write8(bus: u32, slot: u32, fn: u32, offset: u32, value: u8): void {
    arch_out32(3320 as u16, pci_config_address(bus, slot, fn, offset))
    let port: u16 = (3324 + (offset % (4 as u32))) as u16
    arch_out8(port, value)
}

function pci_vendor_id(bus: u32, slot: u32, fn: u32): u16 {
    let value: u32 = pci_read32(bus, slot, fn, 0 as u32)
    return (value % (65536 as u32)) as u16
}

function pci_device_id(bus: u32, slot: u32, fn: u32): u16 {
    let value: u32 = pci_read32(bus, slot, fn, 0 as u32)
    return (value / (65536 as u32)) as u16
}

function pci_enable_device(location: u32): void {
    let bus: u32 = pci_location_bus(location)
    let slot: u32 = pci_location_slot(location)
    let fn: u32 = pci_location_fn(location)
    let command: u16 = pci_read16(bus, slot, fn, 4 as u32)
    let ioEnabled: u16 = command % (2 as u16)
    if ioEnabled == (0 as u16) { command = command + (1 as u16) }
    let memoryEnabled: u16 = (command / (2 as u16)) % (2 as u16)
    if memoryEnabled == (0 as u16) { command = command + (2 as u16) }
    let busMasterEnabled: u16 = (command / (4 as u16)) % (2 as u16)
    if busMasterEnabled == (0 as u16) { command = command + (4 as u16) }
    pci_write16(bus, slot, fn, 4 as u32, command)
}

function pci_count_devices(): usize {
    let count: usize = 0 as usize
    let bus: u32 = 0 as u32
    while bus < (256 as u32) {
        let slot: u32 = 0 as u32
        while slot < (32 as u32) {
            let fn: u32 = 0 as u32
            while fn < (8 as u32) {
                if pci_vendor_id(bus, slot, fn) != (65535 as u16) { count = count + (1 as usize) }
                fn = fn + (1 as u32)
            }
            slot = slot + (1 as u32)
        }
        bus = bus + (1 as u32)
    }
    return count
}

function pci_find_vendor_location(vendorWanted: u16): u32 {
    let bus: u32 = 0 as u32
    while bus < (256 as u32) {
        let slot: u32 = 0 as u32
        while slot < (32 as u32) {
            let fn: u32 = 0 as u32
            while fn < (8 as u32) {
                if pci_vendor_id(bus, slot, fn) == vendorWanted { return (bus * (256 as u32)) + (slot * (8 as u32)) + fn }
                fn = fn + (1 as u32)
            }
            slot = slot + (1 as u32)
        }
        bus = bus + (1 as u32)
    }
    return 65536 as u32
}

function pci_location_bus(location: u32): u32 { return location / (256 as u32) }
function pci_location_slot(location: u32): u32 { return (location % (256 as u32)) / (8 as u32) }
function pci_location_fn(location: u32): u32 { return location % (8 as u32) }
function pci_has_vendor(vendorWanted: u16): bool { return pci_find_vendor_location(vendorWanted) != (65536 as u32) }

function pci_has_device(vendorWanted: u16, deviceWanted: u16): bool {
    let bus: u32 = 0 as u32
    while bus < (256 as u32) {
        let slot: u32 = 0 as u32
        while slot < (32 as u32) {
            let fn: u32 = 0 as u32
            while fn < (8 as u32) {
                if pci_vendor_id(bus, slot, fn) == vendorWanted && pci_device_id(bus, slot, fn) == deviceWanted { return true }
                fn = fn + (1 as u32)
            }
            slot = slot + (1 as u32)
        }
        bus = bus + (1 as u32)
    }
    return false
}
