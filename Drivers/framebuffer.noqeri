module os.drivers.framebuffer

record Mb2Tag {
    kind: u32;
    size: u32;
}

record Mb2FramebufferTag {
    kind: u32;
    size: u32;
    address: u64;
    pitch: u32;
    width: u32;
    height: u32;
    bpp: u8;
    framebufferType: u8;
    reserved: u16;
}

// Multiboot2 tags are 8-byte aligned, bounded by total_size. Do not walk
// untrusted firmware metadata indefinitely or past the allocated boot-info.
function mb2_find_framebuffer(info: usize): usize {
    if info == (0 as usize) || info % (8 as usize) != (0 as usize) {
        return 0 as usize
    }
    let sizePtr: *u32 = info as *u32
    let total: usize = sizePtr[0] as usize
    if total < (16 as usize) || total > (131072 as usize) ||
       total % (8 as usize) != (0 as usize) { return 0 as usize }
    let cursor: usize = info + (8 as usize)
    let end: usize = info + total
    if end < cursor { return 0 as usize }
    while cursor <= end - (8 as usize) {
        let tag: *Mb2Tag = cursor as *Mb2Tag
        if tag.kind == (0 as u32) { return 0 as usize }
        let size: usize = tag.size as usize
        if size < (8 as usize) || size > end - cursor { return 0 as usize }
        if tag.kind == (8 as u32) {
            if size >= (38 as usize) { return cursor }
            return 0 as usize
        }
        let padded: usize = size + (((8 as usize) - (size % (8 as usize))) % (8 as usize))
        if padded > end - cursor { return 0 as usize }
        cursor = cursor + padded
    }
    return 0 as usize
}

// All rendering paths must agree on the exact descriptor and row pitch.
// A firmware mode we cannot safely render should remain serial-only.
function framebuffer_valid(tag: usize): bool {
    if tag == (0 as usize) { return false }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    if fb.size < (38 as u32) || fb.bpp != (32 as u8) ||
       fb.framebufferType != (1 as u8) || fb.address == (0 as u64) ||
       fb.width < (320 as u32) || fb.height < (240 as u32) ||
       fb.width > (4096 as u32) || fb.height > (2160 as u32) ||
       fb.pitch < fb.width * (4 as u32) ||
       fb.pitch > (65536 as u32) ||
       fb.pitch % (4 as u32) != (0 as u32) ||
       fb.address < (1048576 as u64) ||
       fb.address % (4 as u64) != (0 as u64) ||
       fb.address >= (549755813888 as u64) {
        // Keep MMIO below the loader's 512 GiB bootstrap PML4 window.
        return false
    }
    // UEFI maps only the framebuffer aperture, capped at 256 MiB.
    // Reject descriptors that could overflow the mapped physical range
    // even if the width and row pitch looked valid individually.
    let frameBytes: u64 = (fb.pitch as u64) * (fb.height as u64)
    if frameBytes == (0 as u64) ||
       frameBytes > (268435456 as u64) ||
       fb.address > (549755813888 as u64) - frameBytes {
        return false
    }
    let channels: *u8 = (tag + (32 as usize)) as *u8
    return channels[1] == (8 as u8) &&
           channels[2] == (8 as u8) &&
           channels[3] == (8 as u8) &&
           channels[5] == (8 as u8) &&
           ((channels[0] == (0 as u8) && channels[4] == (16 as u8)) ||
            (channels[0] == (16 as u8) && channels[4] == (0 as u8)))
}

function framebuffer_probe(info: usize): bool {
    return framebuffer_valid(mb2_find_framebuffer(info))
}

// Common Noqeri framebuffer drawing core. Colours are 0x00RRGGBB,
// and conversion happens once per rectangle, never in the inner pixel loop.
// No allocation or firmware calls: suitable for both boot splash and desktop.
function framebuffer_pack_rgb(rgb: u32, swapRedBlue: bool): u32 {
    if !swapRedBlue { return rgb }
    let red: u32 = rgb / (65536 as u32)
    let green: u32 = (rgb / (256 as u32)) % (256 as u32)
    let blue: u32 = rgb % (256 as u32)
    return blue * (65536 as u32) + green * (256 as u32) + red
}

// Direct-MMIO rectangle draw. Six parameters fit the current Noqeri ABI.
// The framebuffer tag provides the pitch and bounds.
function framebuffer_fill_rect(tag: usize, left: usize, top: usize,
                               width: usize, height: usize,
                               rgb: u32): bool {
    if !framebuffer_valid(tag) { return false }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    let maxWidth: usize = fb.width as usize
    let maxHeight: usize = fb.height as usize
    if left >= maxWidth || top >= maxHeight { return true }
    let w: usize = width
    let h: usize = height
    if w > maxWidth - left { w = maxWidth - left }
    if h > maxHeight - top { h = maxHeight - top }
    let channels: *u8 = (tag + (32 as usize)) as *u8
    let packed: u32 = framebuffer_pack_rgb(rgb, channels[0] == (0 as u8))
    let pixels: *volatile u32 = (fb.address as usize) as *volatile u32
    let stride: usize = (fb.pitch as usize) / (4 as usize)
    let y: usize = 0 as usize
    while y < h {
        let row: usize = (top + y) * stride + left
        let x: usize = 0 as usize
        while x < w {
            pixels[row + x] = packed
            x = x + (1 as usize)
        }
        y = y + (1 as usize)
    }
    return true
}

// Single-pixel-thick lines use the same clipped MMIO rectangle engine.
// These are suitable for desktop borders and cursor decorations.
function framebuffer_hline(tag: usize, left: usize, top: usize,
                            length: usize, rgb: u32): bool {
    return framebuffer_fill_rect(tag, left, top, length, 1 as usize, rgb)
}

function framebuffer_vline(tag: usize, left: usize, top: usize,
                            length: usize, rgb: u32): bool {
    return framebuffer_fill_rect(tag, left, top, 1 as usize, length, rgb)
}

// CPU-side source-over compositing in canonical RGB space. The framebuffer
// may use RGB or BGR byte order; callers convert at the MMIO boundary.
function framebuffer_blend_rgb(bottom: u32, top: u32, alpha: u32): u32 {
    if alpha == (0 as u32) { return bottom }
    if alpha >= (255 as u32) { return top }
    let inv: u32 = (255 as u32) - alpha
    let br: u32 = (bottom / (65536 as u32)) % (256 as u32)
    let bg: u32 = (bottom / (256 as u32)) % (256 as u32)
    let bb: u32 = bottom % (256 as u32)
    let tr: u32 = (top / (65536 as u32)) % (256 as u32)
    let tg: u32 = (top / (256 as u32)) % (256 as u32)
    let tb: u32 = top % (256 as u32)
    let red: u32 = (tr * alpha + br * inv + (127 as u32)) / (255 as u32)
    let green: u32 = (tg * alpha + bg * inv + (127 as u32)) / (255 as u32)
    let blue: u32 = (tb * alpha + bb * inv + (127 as u32)) / (255 as u32)
    return red * (65536 as u32) + green * (256 as u32) + blue
}

function framebuffer_clear(tag: usize, rgb: u32): bool {
    if !framebuffer_valid(tag) { return false }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    return framebuffer_fill_rect(tag, 0 as usize, 0 as usize,
                                 fb.width as usize, fb.height as usize, rgb)
}

function framebuffer_pixel(tag: usize, x: usize, y: usize, rgb: u32): bool {
    if !framebuffer_valid(tag) { return false }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    if x >= (fb.width as usize) || y >= (fb.height as usize) { return false }
    let channels: *u8 = (tag + (32 as usize)) as *u8
    let pixels: *volatile u32 = (fb.address as usize) as *volatile u32
    let stride: usize = (fb.pitch as usize) / (4 as usize)
    pixels[y * stride + x] = framebuffer_pack_rgb(rgb, channels[0] == (0 as u8))
    return true
}

record FramebufferImage {
    pixels: *u32;
    stride: usize;
    width: usize;
    height: usize;
}

// Blit RGB32 source pixels with software clipping and row-pitch awareness.
// The caller owns the source allocation; no unbounded reads are performed
// when sourceStride >= sourceWidth and sourceHeight is accurate.
function framebuffer_blit_rgb32(tag: usize, destX: usize, destY: usize,
                                source: *FramebufferImage): bool {
    if !framebuffer_valid(tag) || source == null ||
       source.pixels == null || source.stride < source.width ||
       source.stride > (16384 as usize) { return false }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    let maxWidth: usize = fb.width as usize
    let maxHeight: usize = fb.height as usize
    if destX >= maxWidth || destY >= maxHeight { return false }
    let w: usize = source.width
    let h: usize = source.height
    if w > maxWidth - destX { w = maxWidth - destX }
    if h > maxHeight - destY { h = maxHeight - destY }
    let channels: *u8 = (tag + (32 as usize)) as *u8
    let swap: bool = channels[0] == (0 as u8)
    let pixels: *volatile u32 = (fb.address as usize) as *volatile u32
    let stride: usize = (fb.pitch as usize) / (4 as usize)
    let y: usize = 0 as usize
    while y < h {
        let row: usize = (destY + y) * stride + destX
        let sourceRow: usize = y * source.stride
        let x: usize = 0 as usize
        while x < w {
            pixels[row + x] = framebuffer_pack_rgb(source.pixels[sourceRow + x], swap)
            x = x + (1 as usize)
        }
        y = y + (1 as usize)
    }
    return true
}

// ARGB32 source-over blit for translucent icons, window shadows and
// cursor surfaces. Source format is 0xAARRGGBB, destination RGB/BGR comes
// from the Multiboot2 color descriptor. Caller owns the source image.
function framebuffer_blit_argb32(tag: usize, destX: usize, destY: usize,
                                 source: *FramebufferImage): bool {
    if !framebuffer_valid(tag) || source == null ||
       source.pixels == null || source.width == (0 as usize) ||
       source.height == (0 as usize) ||
       source.stride < source.width ||
       source.stride > (16384 as usize) { return false }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    let maxWidth: usize = fb.width as usize
    let maxHeight: usize = fb.height as usize
    if destX >= maxWidth || destY >= maxHeight { return false }
    let w: usize = source.width
    let h: usize = source.height
    if w > maxWidth - destX { w = maxWidth - destX }
    if h > maxHeight - destY { h = maxHeight - destY }
    let channels: *u8 = (tag + (32 as usize)) as *u8
    let swap: bool = channels[0] == (0 as u8)
    let pixels: *volatile u32 = (fb.address as usize) as *volatile u32
    let stride: usize = (fb.pitch as usize) / (4 as usize)
    let y: usize = 0 as usize
    while y < h {
        let row: usize = (destY + y) * stride + destX
        let sourceRow: usize = y * source.stride
        let x: usize = 0 as usize
        while x < w {
            let argb: u32 = source.pixels[sourceRow + x]
            let alpha: u32 = argb / (16777216 as u32)
            if alpha != (0 as u32) {
                let rgb: u32 = argb % (16777216 as u32)
                if alpha == (255 as u32) {
                    pixels[row + x] = framebuffer_pack_rgb(rgb, swap)
                } else {
                    let background: u32 = framebuffer_pack_rgb(pixels[row + x], swap)
                    let mixed: u32 = framebuffer_blend_rgb(background, rgb, alpha)
                    pixels[row + x] = framebuffer_pack_rgb(mixed, swap)
                }
            }
            x = x + (1 as usize)
        }
        y = y + (1 as usize)
    }
    return true
}

function framebuffer_draw_boot_mark(info: usize): bool {
    let tag: usize = mb2_find_framebuffer(info)
    return framebuffer_fill_rect(tag, 0 as usize, 0 as usize,
                                 96 as usize, 64 as usize, 0x002022ff as u32)
}
