module os.drivers.framebuffer

record Mb2Tag {
    kind: u32;
    size: u32;
}

record Mb2FramebufferTag {
    kind: u32;
    size: u32;
    address: u64;
    pitch: u32;
    width: u32;
    height: u32;
    bpp: u8;
    framebufferType: u8;
    reserved: u16;
}

// Multiboot2 tags are 8-byte aligned, bounded by total_size. Do not walk
// untrusted firmware metadata indefinitely or past the allocated boot-info.
function mb2_find_framebuffer(info: usize): usize {
    if info == (0 as usize) || info % (8 as usize) != (0 as usize) {
        return 0 as usize
    }
    let sizePtr: *u32 = info as *u32
    let total: usize = sizePtr[0] as usize
    if total < (16 as usize) || total > (131072 as usize) ||
       total % (8 as usize) != (0 as usize) { return 0 as usize }
    let cursor: usize = info + (8 as usize)
    let end: usize = info + total
    if end < cursor { return 0 as usize }
    while cursor <= end - (8 as usize) {
        let tag: *Mb2Tag = cursor as *Mb2Tag
        if tag.kind == (0 as u32) { return 0 as usize }
        let size: usize = tag.size as usize
        if size < (8 as usize) || size > end - cursor { return 0 as usize }
        if tag.kind == (8 as u32) {
            if size >= (38 as usize) { return cursor }
            return 0 as usize
        }
        let padded: usize = size + (((8 as usize) - (size % (8 as usize))) % (8 as usize))
        if padded > end - cursor { return 0 as usize }
        cursor = cursor + padded
    }
    return 0 as usize
}

// All rendering paths must agree on the exact descriptor and row pitch.
// A firmware mode we cannot safely render should remain serial-only.
function framebuffer_valid(tag: usize): bool {
    if tag == (0 as usize) { return false }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    if fb.size < (38 as u32) || fb.bpp != (32 as u8) ||
       fb.framebufferType != (1 as u8) || fb.address == (0 as u64) ||
       fb.width < (320 as u32) || fb.height < (240 as u32) ||
       fb.width > (4096 as u32) || fb.height > (2160 as u32) ||
       fb.pitch < fb.width * (4 as u32) ||
       fb.pitch > (65536 as u32) ||
       fb.pitch % (4 as u32) != (0 as u32) ||
       fb.address >= (549755813888 as u64) {
        // Keep MMIO below the loader's 512 GiB bootstrap PML4 window.
        return false
    }
    let channels: *u8 = (tag + (32 as usize)) as *u8
    return zig_fb_valid(tag) && channels[1] == (8 as u8) &&
           channels[2] == (8 as u8) &&
           channels[3] == (8 as u8) &&
           channels[5] == (8 as u8) &&
           ((channels[0] == (0 as u8) && channels[4] == (16 as u8)) ||
            (channels[0] == (16 as u8) && channels[4] == (0 as u8)))
}

function framebuffer_probe(info: usize): bool {
    return framebuffer_valid(mb2_find_framebuffer(info))
}

// Zig implements MMIO drawing; Noqeri preserves the stable driver API.
// A raw integer tag pointer keeps the ABI independent of record padding.
extern function zig_fb_valid(tag: usize): bool;
extern function zig_fb_fill_rect(tag: usize, left: usize, top: usize,
                                 width: usize, height: usize, rgb: u32): bool;
extern function zig_fb_pixel(tag: usize, x: usize, y: usize, rgb: u32): bool;
extern function zig_fb_blit(tag: usize, destX: usize, destY: usize,
                            sourceAddress: usize): bool;

function framebuffer_pack_rgb(rgb: u32, swapRedBlue: bool): u32 {
    if !swapRedBlue { return rgb }
    let red: u32 = rgb / (65536 as u32)
    let green: u32 = (rgb / (256 as u32)) % (256 as u32)
    let blue: u32 = rgb % (256 as u32)
    return blue * (65536 as u32) + green * (256 as u32) + red
}

function framebuffer_fill_rect(tag: usize, left: usize, top: usize,
                               width: usize, height: usize,
                               rgb: u32): bool {
    if !framebuffer_valid(tag) { return false }
    return zig_fb_fill_rect(tag, left, top, width, height, rgb)
}

function framebuffer_clear(tag: usize, rgb: u32): bool {
    if !framebuffer_valid(tag) { return false }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    return zig_fb_fill_rect(tag, 0 as usize, 0 as usize,
                            fb.width as usize, fb.height as usize, rgb)
}

function framebuffer_pixel(tag: usize, x: usize, y: usize, rgb: u32): bool {
    if !framebuffer_valid(tag) { return false }
    return zig_fb_pixel(tag, x, y, rgb)
}

record FramebufferImage {
    pixels: *u32;
    stride: usize;
    width: usize;
    height: usize;
}

function framebuffer_blit_rgb32(tag: usize, destX: usize, destY: usize,
                                source: *FramebufferImage): bool {
    if !framebuffer_valid(tag) || source == null { return false }
    return zig_fb_blit(tag, destX, destY, source as usize)
}

function framebuffer_draw_boot_mark(info: usize): bool {
    let tag: usize = mb2_find_framebuffer(info)
    return framebuffer_fill_rect(tag, 0 as usize, 0 as usize,
                                 96 as usize, 64 as usize, 0x002022ff as u32)
}

// Outline a clipped rectangle using the shared pitch-aware fill primitive.
// Width/height are dimensions, never exclusive end coordinates, so no
// left+width or top+height arithmetic can overflow.
function framebuffer_stroke_rect(tag: usize, left: usize, top: usize,
                                 width: usize, height: usize,
                                 thickness: usize, rgb: u32): bool {
    if !framebuffer_valid(tag) { return false }
    if width == (0 as usize) || height == (0 as usize) ||
       thickness == (0 as usize) { return true }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    let maxWidth: usize = fb.width as usize
    let maxHeight: usize = fb.height as usize
    if left >= maxWidth || top >= maxHeight { return true }
    let w: usize = width
    let h: usize = height
    if w > maxWidth - left { w = maxWidth - left }
    if h > maxHeight - top { h = maxHeight - top }
    let edge: usize = thickness
    if edge > w { edge = w }
    if edge > h { edge = h }
    framebuffer_fill_rect(tag, left, top, w, edge, rgb)
    framebuffer_fill_rect(tag, left, top + h - edge, w, edge, rgb)
    framebuffer_fill_rect(tag, left, top, edge, h, rgb)
    framebuffer_fill_rect(tag, left + w - edge, top, edge, h, rgb)
    return true
}

// Draw a horizontal progress track with a clamped percentage. Rendering
// stays inside Noqeri and supports both standard Multiboot2 RGB byte orders.
function framebuffer_progress(tag: usize, left: usize, top: usize,
                              width: usize, height: usize,
                              percent: usize): bool {
    if !framebuffer_valid(tag) { return false }
    let done: usize = percent
    if done > (100 as usize) { done = 100 as usize }
    if !framebuffer_fill_rect(tag, left, top, width, height,
                              0x00383838 as u32) { return false }
    // Divide before multiplying to avoid overflow on untrusted dimensions.
    let filled: usize = (width / (100 as usize)) * done +
                        ((width % (100 as usize)) * done) / (100 as usize)
    return framebuffer_fill_rect(tag, left, top, filled, height,
                                 0x00fb5607 as u32)
}
