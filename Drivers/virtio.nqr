module os.drivers.virtio

import "pci.nqr"

function virtio_find_capability(location: u32, wantedType: u8): u32 {
    if location == (65536 as u32) { return 0 as u32 }
    let bus: u32 = pci_location_bus(location)
    let slot: u32 = pci_location_slot(location)
    let fn: u32 = pci_location_fn(location)
    let capability: u32 = (pci_read8(bus, slot, fn, 52 as u32)) as u32
    let walked: usize = 0 as usize
    while capability != (0 as u32) && walked < 48 {
        let capabilityId: u8 = pci_read8(bus, slot, fn, capability)
        let nextCapability: u32 = (pci_read8(bus, slot, fn, capability + (1 as u32))) as u32
        if capabilityId == (9 as u8) && pci_read8(bus, slot, fn, capability + (3 as u32)) == wantedType { return capability }
        capability = nextCapability
        walked = walked + 1
    }
    return 0 as u32
}

function virtio_modern_transport_present(location: u32): bool {
    return virtio_find_capability(location, 1 as u8) != (0 as u32) &&
           virtio_find_capability(location, 2 as u8) != (0 as u32) &&
           virtio_find_capability(location, 3 as u8) != (0 as u32) &&
           virtio_find_capability(location, 5 as u8) != (0 as u32)
}

function virtio_pci_cfg_prepare(location: u32, targetCapability: u32, targetOffset: u32, length: u32): u32 {
    let pciCfgCapability: u32 = virtio_find_capability(location, 5 as u8)
    if pciCfgCapability == (0 as u32) || targetCapability == (0 as u32) { return 0 as u32 }
    let bus: u32 = pci_location_bus(location)
    let slot: u32 = pci_location_slot(location)
    let fn: u32 = pci_location_fn(location)
    let targetBar: u8 = pci_read8(bus, slot, fn, targetCapability + (4 as u32))
    let targetBaseOffset: u32 = pci_read32(bus, slot, fn, targetCapability + (8 as u32))
    pci_write8(bus, slot, fn, pciCfgCapability + (4 as u32), targetBar)
    pci_write32(bus, slot, fn, pciCfgCapability + (8 as u32), targetBaseOffset + targetOffset)
    pci_write32(bus, slot, fn, pciCfgCapability + (12 as u32), length)
    return pciCfgCapability
}

function virtio_pci_cfg_read8(location: u32, targetCapability: u32, targetOffset: u32): u8 {
    let cfg: u32 = virtio_pci_cfg_prepare(location, targetCapability, targetOffset, 1 as u32)
    if cfg == (0 as u32) { return 255 as u8 }
    return pci_read8(pci_location_bus(location), pci_location_slot(location), pci_location_fn(location), cfg + (16 as u32))
}

function virtio_pci_cfg_write8(location: u32, targetCapability: u32, targetOffset: u32, value: u8): bool {
    let cfg: u32 = virtio_pci_cfg_prepare(location, targetCapability, targetOffset, 1 as u32)
    if cfg == (0 as u32) { return false }
    pci_write8(pci_location_bus(location), pci_location_slot(location), pci_location_fn(location), cfg + (16 as u32), value)
    return true
}

function virtio_pci_cfg_read16(location: u32, targetCapability: u32, targetOffset: u32): u16 {
    let cfg: u32 = virtio_pci_cfg_prepare(location, targetCapability, targetOffset, 2 as u32)
    if cfg == (0 as u32) { return 65535 as u16 }
    return pci_read16(pci_location_bus(location), pci_location_slot(location), pci_location_fn(location), cfg + (16 as u32))
}

function virtio_pci_cfg_write16(location: u32, targetCapability: u32, targetOffset: u32, value: u16): bool {
    let cfg: u32 = virtio_pci_cfg_prepare(location, targetCapability, targetOffset, 2 as u32)
    if cfg == (0 as u32) { return false }
    pci_write16(pci_location_bus(location), pci_location_slot(location), pci_location_fn(location), cfg + (16 as u32), value)
    return true
}

function virtio_pci_cfg_read32(location: u32, targetCapability: u32, targetOffset: u32): u32 {
    let cfg: u32 = virtio_pci_cfg_prepare(location, targetCapability, targetOffset, 4 as u32)
    if cfg == (0 as u32) { return 4294967295 as u32 }
    return pci_read32(pci_location_bus(location), pci_location_slot(location), pci_location_fn(location), cfg + (16 as u32))
}

function virtio_pci_cfg_write32(location: u32, targetCapability: u32, targetOffset: u32, value: u32): bool {
    let cfg: u32 = virtio_pci_cfg_prepare(location, targetCapability, targetOffset, 4 as u32)
    if cfg == (0 as u32) { return false }
    pci_write32(pci_location_bus(location), pci_location_slot(location), pci_location_fn(location), cfg + (16 as u32), value)
    return true
}

function virtio_pci_cfg_write64(location: u32, targetCapability: u32, targetOffset: u32, value: u64): bool {
    let low: u32 = (value % (4294967296 as u64)) as u32
    let high: u32 = (value / (4294967296 as u64)) as u32
    if !virtio_pci_cfg_write32(location, targetCapability, targetOffset, low) { return false }
    return virtio_pci_cfg_write32(location, targetCapability, targetOffset + (4 as u32), high)
}

function virtio_status_handshake(location: u32): bool {
    let common: u32 = virtio_find_capability(location, 1 as u8)
    if common == (0 as u32) { return false }
    if !virtio_pci_cfg_write8(location, common, 20 as u32, 0 as u8) { return false }
    if virtio_pci_cfg_read8(location, common, 20 as u32) != (0 as u8) { return false }
    if !virtio_pci_cfg_write8(location, common, 20 as u32, 1 as u8) { return false }
    if !virtio_pci_cfg_write8(location, common, 20 as u32, 3 as u8) { return false }
    let status: u8 = virtio_pci_cfg_read8(location, common, 20 as u32)
    virtio_pci_cfg_write8(location, common, 20 as u32, 0 as u8)
    return status == (3 as u8)
}

function virtio_begin_driver(location: u32): bool {
    let common: u32 = virtio_find_capability(location, 1 as u8)
    if common == (0 as u32) { return false }
    pci_enable_device(location)
    virtio_pci_cfg_write8(location, common, 20 as u32, 0 as u8)
    if virtio_pci_cfg_read8(location, common, 20 as u32) != (0 as u8) { return false }
    virtio_pci_cfg_write8(location, common, 20 as u32, 1 as u8)
    virtio_pci_cfg_write8(location, common, 20 as u32, 3 as u8)

    virtio_pci_cfg_write32(location, common, 0 as u32, 1 as u32)
    let highFeatures: u32 = virtio_pci_cfg_read32(location, common, 4 as u32)
    let versionOnePresent: u32 = highFeatures % (2 as u32)
    if versionOnePresent == (0 as u32) { virtio_pci_cfg_write8(location, common, 20 as u32, 0 as u8); return false }

    virtio_pci_cfg_write32(location, common, 8 as u32, 0 as u32)
    virtio_pci_cfg_write32(location, common, 12 as u32, 0 as u32)
    virtio_pci_cfg_write32(location, common, 8 as u32, 1 as u32)
    virtio_pci_cfg_write32(location, common, 12 as u32, 1 as u32)
    virtio_pci_cfg_write8(location, common, 20 as u32, 11 as u8)

    let status: u8 = virtio_pci_cfg_read8(location, common, 20 as u32)
    return ((status as u32) / (8 as u32)) % (2 as u32) == (1 as u32)
}

function virtio_queue_setup(location: u32, queueIndex: u16, desc: usize, avail: usize, used: usize): u32 {
    let common: u32 = virtio_find_capability(location, 1 as u8)
    if common == (0 as u32) { return 4294967295 as u32 }
    virtio_pci_cfg_write16(location, common, 22 as u32, queueIndex)
    let maxSize: u16 = virtio_pci_cfg_read16(location, common, 24 as u32)
    if maxSize == (0 as u16) { return 4294967295 as u32 }
    let queueSize: u16 = 8 as u16
    if maxSize < queueSize { queueSize = maxSize }
    virtio_pci_cfg_write16(location, common, 24 as u32, queueSize)
    virtio_pci_cfg_write64(location, common, 32 as u32, desc as u64)
    virtio_pci_cfg_write64(location, common, 40 as u32, avail as u64)
    virtio_pci_cfg_write64(location, common, 48 as u32, used as u64)
    let notifyOffset: u16 = virtio_pci_cfg_read16(location, common, 30 as u32)
    virtio_pci_cfg_write16(location, common, 28 as u32, 1 as u16)
    return notifyOffset as u32
}

function virtio_driver_ok(location: u32): bool {
    let common: u32 = virtio_find_capability(location, 1 as u8)
    if common == (0 as u32) { return false }
    virtio_pci_cfg_write8(location, common, 20 as u32, 15 as u8)
    let status: u8 = virtio_pci_cfg_read8(location, common, 20 as u32)
    return ((status as u32) / (4 as u32)) % (2 as u32) == (1 as u32)
}

function virtio_notify_queue(location: u32, queueIndex: u16, notifyOffset: u32): bool {
    let notify: u32 = virtio_find_capability(location, 2 as u8)
    if notify == (0 as u32) { return false }
    let bus: u32 = pci_location_bus(location)
    let slot: u32 = pci_location_slot(location)
    let fn: u32 = pci_location_fn(location)
    let multiplier: u32 = pci_read32(bus, slot, fn, notify + (16 as u32))
    return virtio_pci_cfg_write16(location, notify, notifyOffset * multiplier, queueIndex)
}

function virtio_reset(location: u32): void {
    let common: u32 = virtio_find_capability(location, 1 as u8)
    if common != (0 as u32) { virtio_pci_cfg_write8(location, common, 20 as u32, 0 as u8) }
}
