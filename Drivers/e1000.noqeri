module os.drivers.e1000

import "pci.noqeri"
import "../Arch/x86_64/api.noqeri"

// Intel 82540EM (8086:100e) register interface, via PCI BAR1 I/O ports.
// Do not treat other e1000/e1000e/igc device IDs as compatible without
// model-specific initialization. DMA remains below the bootstrap 1 GiB map.
record E1000 {
    location: u32;
    ioPort: u16;
    rxDescriptors: usize;
    txDescriptors: usize;
    txBuffer: usize;
    mac: *u8;
    rx0: usize;
    rx1: usize;
    rx2: usize;
    rx3: usize;
    rx4: usize;
    rx5: usize;
    rx6: usize;
    rx7: usize;
    rxIndex: usize;
    txIndex: usize;
    ready: bool;
}

function e1000_reg_read(dev: *E1000, offset: u32): u32 {
    arch_out32(dev.ioPort, offset)
    return arch_in32((dev.ioPort + (4 as u16)) as u16)
}
function e1000_reg_write(dev: *E1000, offset: u32, value: u32): void {
    arch_out32(dev.ioPort, offset)
    arch_out32((dev.ioPort + (4 as u16)) as u16, value)
}
function e1000_clear(address: usize, length: usize): void {
    let data: *u8 = address as *u8
    let i: usize = 0 as usize
    while i < length {
        data[i] = 0 as u8
        i = i + (1 as usize)
    }
}
function e1000_buffer(dev: *E1000, index: usize): usize {
    if index == (0 as usize) { return dev.rx0 }
    if index == (1 as usize) { return dev.rx1 }
    if index == (2 as usize) { return dev.rx2 }
    if index == (3 as usize) { return dev.rx3 }
    if index == (4 as usize) { return dev.rx4 }
    if index == (5 as usize) { return dev.rx5 }
    if index == (6 as usize) { return dev.rx6 }
    return dev.rx7
}
function e1000_open(location: u32, dev: *E1000): bool {
    if dev == null || location == (65536 as u32) { return false }
    if pci_device_id(pci_location_bus(location), pci_location_slot(location), pci_location_fn(location)) != (4110 as u16) {
        arch_out8(233 as u16, 49 as u8)
        return false
    }
    let bus: u32 = pci_location_bus(location)
    let slot: u32 = pci_location_slot(location)
    let fn: u32 = pci_location_fn(location)
    let bar1: u32 = pci_read32(bus, slot, fn, 20 as u32)
    // For this Intel model BAR1 is its 64-byte I/O window.
    if bar1 == (0 as u32) || bar1 == (4294967295 as u32) ||
       (bar1 % (2 as u32)) != (1 as u32) {
        arch_out8(233 as u16, 50 as u8)
        return false
    }
    let port: u32 = (bar1 / (4 as u32)) * (4 as u32)
    if port == (0 as u32) || port > (65472 as u32) {
        arch_out8(233 as u16, 51 as u8)
        return false
    }
    dev.ready = false
    dev.ioPort = port as u16
    dev.location = location
    pci_enable_device(location)

    // Disable NIC interrupts: the bootstrap driver polls completion.
    e1000_reg_write(dev, 0x00d8 as u32, 4294967295 as u32)
    e1000_reg_read(dev, 0x00c0 as u32)
    // Explicitly enable Ethernet link (CTRL.SLU), preserve firmware config.
    let control: u32 = e1000_reg_read(dev, 0 as u32)
    if ((control / (64 as u32)) % (2 as u32)) == (0 as u32) {
        e1000_reg_write(dev, 0 as u32, control + (64 as u32))
    }

    dev.rxDescriptors = arch_alloc_page()
    dev.txDescriptors = arch_alloc_page()
    dev.txBuffer = arch_alloc_page()
    let macPage: usize = arch_alloc_page()
    dev.rx0 = arch_alloc_page()
    dev.rx1 = arch_alloc_page()
    dev.rx2 = arch_alloc_page()
    dev.rx3 = arch_alloc_page()
    dev.rx4 = arch_alloc_page()
    dev.rx5 = arch_alloc_page()
    dev.rx6 = arch_alloc_page()
    dev.rx7 = arch_alloc_page()
    if dev.rxDescriptors == 0 || dev.txDescriptors == 0 ||
       dev.txBuffer == 0 || macPage == 0 ||
       dev.rx0 == 0 || dev.rx1 == 0 || dev.rx2 == 0 ||
       dev.rx3 == 0 || dev.rx4 == 0 || dev.rx5 == 0 ||
       dev.rx6 == 0 || dev.rx7 == 0 {
        arch_out8(233 as u16, 52 as u8)
        return false
    }
    e1000_clear(dev.rxDescriptors, 4096 as usize)
    e1000_clear(dev.txDescriptors, 4096 as usize)
    e1000_clear(dev.txBuffer, 4096 as usize)
    dev.mac = macPage as *u8

    // RAL0/RAH0: MAC programmed by PCI firmware/device EEPROM.
    let low: u32 = e1000_reg_read(dev, 0x5400 as u32)
    let high: u32 = e1000_reg_read(dev, 0x5404 as u32)
    if (low == (0 as u32) && (high % (65536 as u32)) == (0 as u32)) {
        arch_out8(233 as u16, 53 as u8)
        return false
    }
    let i: usize = 0 as usize
    while i < (4 as usize) {
        dev.mac[i] = ((low / (1 as u32)) % (256 as u32)) as u8
        low = low / (256 as u32)
        i = i + (1 as usize)
    }
    dev.mac[4] = (high % (256 as u32)) as u8
    dev.mac[5] = ((high / (256 as u32)) % (256 as u32)) as u8

    let index: usize = 0 as usize
    while index < (8 as usize) {
        let base: usize = dev.rxDescriptors + index * (16 as usize)
        let address: *u64 = base as *u64
        address[0] = e1000_buffer(dev, index) as u64
        index = index + (1 as usize)
    }
    e1000_reg_write(dev, 0x2800 as u32, dev.rxDescriptors as u32) // RDBAL
    e1000_reg_write(dev, 0x2804 as u32, 0 as u32) // RDBAH
    e1000_reg_write(dev, 0x2808 as u32, 128 as u32) // RDLEN
    e1000_reg_write(dev, 0x2810 as u32, 0 as u32) // RDH
    e1000_reg_write(dev, 0x2818 as u32, 7 as u32) // RDT
    // RCTL EN | SBP | BAM | SECRC, 2048-byte receive buffers.
    e1000_reg_write(dev, 0x0100 as u32, 0x04008006 as u32)

    e1000_reg_write(dev, 0x3800 as u32, dev.txDescriptors as u32)
    e1000_reg_write(dev, 0x3804 as u32, 0 as u32)
    e1000_reg_write(dev, 0x3808 as u32, 128 as u32)
    e1000_reg_write(dev, 0x3810 as u32, 0 as u32)
    e1000_reg_write(dev, 0x3818 as u32, 0 as u32)
    // TCTL EN | PSP | CT=15 | COLD=64.
    e1000_reg_write(dev, 0x0400 as u32, 0x00400f0a as u32)
    e1000_reg_write(dev, 0x0410 as u32, 0x0060200a as u32) // TIPG
    dev.rxIndex = 0 as usize
    dev.txIndex = 0 as usize
    dev.ready = true
    return true
}
function e1000_send(dev: *E1000, frame: usize, length: usize): bool {
    if dev == null || !dev.ready || frame == 0 ||
       length < (14 as usize) || length > (1514 as usize) { return false }
    let src: *u8 = frame as *u8
    let dst: *u8 = dev.txBuffer as *u8
    let i: usize = 0 as usize
    while i < length {
        dst[i] = src[i]
        i = i + (1 as usize)
    }
    let base: usize = dev.txDescriptors + dev.txIndex * (16 as usize)
    let address: *u64 = base as *u64
    let wireLength: *u16 = (base + (8 as usize)) as *u16
    let command: *volatile u8 = (base + (11 as usize)) as *volatile u8
    let status: *volatile u8 = (base + (12 as usize)) as *volatile u8
    address[0] = dev.txBuffer as u64
    wireLength[0] = length as u16
    status[0] = 0 as u8
    command[0] = 11 as u8 // EOP | IFCS | RS
    atomicFence()
    dev.txIndex = (dev.txIndex + (1 as usize)) % (8 as usize)
    e1000_reg_write(dev, 0x3818 as u32, dev.txIndex as u32)
    let spins: usize = 0 as usize
    while ((status[0] as usize) % (2 as usize)) == (0 as usize) &&
          spins < (4000000 as usize) {
        intrinsic("x86.pause")
        spins = spins + (1 as usize)
    }
    atomicFence()
    return ((status[0] as usize) % (2 as usize)) == (1 as usize)
}
function e1000_receive(dev: *E1000, destination: usize, capacity: usize, timeout: usize): usize {
    if dev == null || !dev.ready || destination == 0 { return 0 as usize }
    let base: usize = dev.rxDescriptors + dev.rxIndex * (16 as usize)
    let status: *volatile u8 = (base + (12 as usize)) as *volatile u8
    let spins: usize = 0 as usize
    while ((status[0] as usize) % (2 as usize)) == (0 as usize) && spins < timeout {
        intrinsic("x86.pause")
        spins = spins + (1 as usize)
    }
    if ((status[0] as usize) % (2 as usize)) == (0 as usize) { return 0 as usize }
    atomicFence()
    let packetLength: *u16 = (base + (8 as usize)) as *u16
    let errors: *u8 = (base + (13 as usize)) as *u8
    let length: usize = packetLength[0] as usize
    let result: usize = 0 as usize
    // The descriptor must contain one full frame and no receive errors.
    if errors[0] == (0 as u8) &&
       ((status[0] as u32) / (2 as u32)) % (2 as u32) == (1 as u32) &&
       length >= (14 as usize) && length <= (1514 as usize) &&
       length <= capacity {
        let out: *u8 = destination as *u8
        let src: *u8 = e1000_buffer(dev, dev.rxIndex) as *u8
        let i: usize = 0 as usize
        while i < length {
            out[i] = src[i]
            i = i + (1 as usize)
        }
        result = length
    }
    status[0] = 0 as u8
    let released: usize = dev.rxIndex
    dev.rxIndex = (dev.rxIndex + (1 as usize)) % (8 as usize)
    atomicFence()
    e1000_reg_write(dev, 0x2818 as u32, released as u32)
    return result
}
function e1000_close(dev: *E1000): void {
    if dev != null && dev.ready {
        e1000_reg_write(dev, 0x0100 as u32, 0 as u32)
        e1000_reg_write(dev, 0x0400 as u32, 0 as u32)
        dev.ready = false
    }
}
