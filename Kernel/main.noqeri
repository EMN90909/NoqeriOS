module os.kernel

import "../Arch/x86_64/api.noqeri"
import "../Bootloader/handoff.noqeri"
import "../Drivers/serial.noqeri"
import "../Drivers/framebuffer.noqeri"
import "../Drivers/gpu.noqeri"
import "../Drivers/virtio_gpu_display.noqeri"
import "../Drivers/pci.noqeri"
import "../Drivers/virtio.noqeri"
import "../Drivers/virtio_rng.noqeri"
import "../Drivers/virtio_block.noqeri"
import "memory.noqeri"
import "Memory/pmm.noqeri"
import "Memory/vmm.noqeri"
import "Memory/heap.noqeri"
import "scheduler.noqeri"
import "cpu_topology.noqeri"
import "gui.noqeri"
import "boot_splash.noqeri"
import "file_manager.noqeri"
import "syscall.noqeri"
import "fs/vfs.noqeri"
import "terminal.noqeri"
import "net/ipv4.noqeri"
import "net/dns.noqeri"

export function kernel_main(multibootInfo: usize): void {
    arch_cli()
    serial_init()
    if !boot_info_valid(multibootInfo) {
        serial_write("NoqeriOS: invalid Multiboot2 handoff\n")
        while true { arch_halt() }
    }
    serial_write("NoqeriOS: entered 64-bit Noqeri kernel\n")
    serial_write("NoqeriOS: serial driver online\n")

    // Present branded loading UI before any expensive hardware or memory work.
    // Keep early marker for MMIO regression diagnostics, then replace it with
    // the Noqeri progress screen. Serial-only BIOS remains supported.
    let splashActive: bool = false
    if framebuffer_probe(multibootInfo) {
        if framebuffer_draw_boot_mark(multibootInfo) {
            serial_write("NoqeriOS: early framebuffer boot marker displayed\n")
        }
        splashActive = boot_splash_begin(multibootInfo)
        if splashActive {
            serial_write("NoqeriOS: boot splash active\n")
        }
    }


    let memoryReady: bool = false
    let pmmAddress: usize = 0 as usize
    let kernelStart: usize = arch_kernel_start()
    let kernelEnd: usize = arch_kernel_end()
    let memoryStart: usize = usable_region_start(multibootInfo, kernelEnd)
    let memoryEnd: usize = usable_region_end(multibootInfo, kernelEnd)

    if memoryStart != (0 as usize) && memoryEnd > memoryStart && arch_early_allocator_set(memoryStart, memoryEnd) {
        serial_write("NoqeriOS: physical memory map accepted\n")
        let metadataPages: usize = pmm_required_metadata_pages(multibootInfo)
        let metadataBase: usize = 0 as usize
        let metadataReady: bool = metadataPages > (0 as usize)

        if metadataReady {
            metadataBase = arch_alloc_page()
            if metadataBase == (0 as usize) {
                metadataReady = false
            }
        }

        let metadataIndex: usize = 1 as usize
        while metadataReady && metadataIndex < metadataPages {
            let metadataPage: usize = arch_alloc_page()
            let expectedPage: usize = metadataBase + (metadataIndex * (4096 as usize))
            if metadataPage != expectedPage {
                metadataReady = false
            }
            metadataIndex = metadataIndex + (1 as usize)
        }

        let pmmStatePage: usize = 0 as usize
        if metadataReady {
            pmmStatePage = arch_alloc_page()
        }

        if metadataReady && pmmStatePage != (0 as usize) {
            let pmm: *PhysicalMemoryManager = pmmStatePage as *PhysicalMemoryManager
            let bootstrapEnd: usize = pmmStatePage + (4096 as usize)
            if pmm_initialize(multibootInfo, kernelStart, bootstrapEnd, metadataBase, metadataPages, pmm) {
                pmmAddress = pmmStatePage
                memoryReady = true
                serial_write("NoqeriOS: bitmap physical memory manager online\n")

                if pmm_self_test(pmm) {
                    serial_write("NoqeriOS: PMM alloc free reserve and contiguous tests passed\n")
                } else {
                    serial_write("NoqeriOS: PMM self-test failed\n")
                    memoryReady = false
                }

                let firstPage: usize = pmm_alloc_page(pmm)
                if firstPage != (0 as usize) {
                    serial_write("NoqeriOS: physical page allocation succeeded\n")
                    if !pmm_free_page(pmm, firstPage) {
                        serial_write("NoqeriOS: physical page free failed\n")
                        memoryReady = false
                    }
                } else {
                    serial_write("NoqeriOS: physical page allocation failed\n")
                    memoryReady = false
                }

                if memoryReady {
                    if vmm_self_test(pmm) {
                        serial_write("NoqeriOS: VMM isolated CR3 map unmap protect test passed\n")
                    } else {
                        serial_write("NoqeriOS: VMM self-test failed\n")
                        memoryReady = false
                    }
                }

                if memoryReady {
                    let heapStatePage: usize = pmm_alloc_page(pmm)
                    if heapStatePage != (0 as usize) {
                        let heap: *KernelHeap = heapStatePage as *KernelHeap
                        if heap_initialize(heap, pmmStatePage as *PhysicalMemoryManager) && heap_self_test(heap) {
                            serial_write("NoqeriOS: kernel heap alloc free reuse stress passed\n")
                        } else {
                            serial_write("NoqeriOS: kernel heap self-test failed\n")
                            memoryReady = false
                        }
                    } else {
                        serial_write("NoqeriOS: kernel heap state allocation failed\n")
                        memoryReady = false
                    }
                }

                if memoryReady {
                    // Existing bootstrap drivers still request pages through arch_alloc_page.
                    // Back that compatibility interface with a PMM-owned 2 MiB pool so it
                    // cannot collide with the new allocator while those drivers migrate.
                    let compatibilityPool: usize = pmm_alloc_contiguous(pmm, 512 as usize)
                    if compatibilityPool != (0 as usize) && arch_early_allocator_set(compatibilityPool, compatibilityPool + (2097152 as usize)) {
                        serial_write("NoqeriOS: legacy page allocator rebased onto PMM-owned pool\n")
                    } else {
                        serial_write("NoqeriOS: PMM compatibility pool setup failed\n")
                        arch_early_allocator_set(0 as usize, 0 as usize)
                        memoryReady = false
                    }
                }
            } else {
                serial_write("NoqeriOS: bitmap PMM initialization failed\n")
            }
        } else {
            serial_write("NoqeriOS: PMM metadata allocation failed\n")
        }
    } else {
        serial_write("NoqeriOS: no usable physical memory region found\n")
    }

    if pmmAddress == (0 as usize) {
        serial_write("NoqeriOS: native memory core unavailable\n")
    }
    if splashActive { boot_splash_update(multibootInfo, 30 as usize) }

    if memoryReady {
        let schedulerPage: usize = arch_alloc_page()
        let processOnePage: usize = arch_alloc_page()
        let processTwoPage: usize = arch_alloc_page()
        if scheduler_self_test(schedulerPage, processOnePage, processTwoPage) {
            serial_write("NoqeriOS: round-robin process scheduler core active\n")
        } else {
            serial_write("NoqeriOS: scheduler core self-test failed\n")
        }
    }

    let cpuRegistry: *CpuRegistry = null
    if memoryReady {
        cpuRegistry = cpu_registry_boot(multibootInfo)
        if cpuRegistry != null {
            serial_write("NoqeriOS: CPU topology capacity 250 validated\n")
            if cpuRegistry.hasMadt {
                serial_write("NoqeriOS: ACPI MADT CPU topology discovered\n")
            } else {
                serial_write("NoqeriOS: ACPI CPU topology unavailable; BSP fallback\n")
            }
            serial_write("NoqeriOS: only boot processor online (SMP pending)\n")
        } else {
            serial_write("NoqeriOS: CPU registry initialization failed\n")
        }
    }

    if splashActive { boot_splash_update(multibootInfo, 48 as usize) }

    let pciDevices: usize = pci_count_devices()
    if pciDevices > 0 {
        serial_write("NoqeriOS: PCI configuration space enumerated\n")
    } else {
        serial_write("NoqeriOS: PCI enumeration found no devices\n")
    }

    if splashActive { boot_splash_update(multibootInfo, 62 as usize) }

    let rngLocation: u32 = pci_find_device_location(6900 as u16, 4164 as u16)
    if rngLocation != (65536 as u32) {
        serial_write("NoqeriOS: VirtIO RNG PCI device detected\n")
        if virtio_modern_transport_present(rngLocation) {
            serial_write("NoqeriOS: modern VirtIO PCI transport capabilities detected\n")
            if virtio_status_handshake(rngLocation) {
                serial_write("NoqeriOS: VirtIO common-config status handshake succeeded\n")
            } else {
                serial_write("NoqeriOS: VirtIO common-config status handshake failed\n")
            }
            if virtio_rng_dma_test(rngLocation) {
                serial_write("NoqeriOS: VirtIO RNG DMA request completed\n")
            } else {
                serial_write("NoqeriOS: VirtIO RNG DMA request failed\n")
            }
        } else {
            serial_write("NoqeriOS: VirtIO RNG lacks required modern PCI capabilities\n")
        }
    } else {
        serial_write("NoqeriOS: VirtIO RNG device not found\n")
    }

    let explorerFiles: *FileManager = null
    let blockLocation: u32 = pci_find_device_location(6900 as u16, 4162 as u16)
    if blockLocation != (65536 as u32) {
        serial_write("NoqeriOS: VirtIO block device detected\n")
        if virtio_modern_transport_present(blockLocation) && virtio_block_read_smoke(blockLocation) {
            serial_write("NoqeriOS: VirtIO block sector read succeeded\n")
            if vfs_probe_boot_volume(blockLocation) {
                serial_write("NoqeriOS: NoqFS boot volume recognized by VFS\n")
                let vfsTest: isize = vfs_boot_file_test(blockLocation)
                if vfsTest == (1 as isize) {
                    serial_write("NoqeriOS: VFS opened and read a NoqFS file\n")
                    explorerFiles = files_open(blockLocation)
                    if explorerFiles != null {
                        serial_write("NoqeriOS: NoqFS file explorer ready (read-only)\n")
                    }
                } else if vfsTest == (-2 as isize) {
                    serial_write("NoqeriOS: VFS file test remount failed\n")
                } else if vfsTest == (-4 as isize) {
                    serial_write("NoqeriOS: VFS file payload read failed\n")
                } else if vfsTest == (-5 as isize) {
                    serial_write("NoqeriOS: VFS file payload marker mismatch\n")
                } else if vfsTest == (-12 as isize) {
                    serial_write("NoqeriOS: NoqFS mount lost root entry count\n")
                } else if vfsTest == (-13 as isize) {
                    serial_write("NoqeriOS: NoqFS mount lost root directory sector\n")
                } else if vfsTest == (-15 as isize) {
                    serial_write("NoqeriOS: NoqFS root directory sector read failed\n")
                } else if vfsTest == (-16 as isize) {
                    serial_write("NoqeriOS: NoqFS root directory key mismatch\n")
                } else {
                    serial_write("NoqeriOS: VFS file test metadata/allocation failed\n")
                }
            } else {
                serial_write("NoqeriOS: NoqFS boot volume probe failed\n")
            }
        } else {
            serial_write("NoqeriOS: VirtIO block sector read failed\n")
        }
    } else {
        serial_write("NoqeriOS: VirtIO block device not found\n")
    }

    // Optional network adapter: DHCP and ARP use bounded polling, never
    // block kernel boot permanently when networking is absent.
    if network_packet_fixture_self_test() {
        serial_write("NoqeriOS: IPv4 DHCP packet validation fixture passed\n")
    } else {
        serial_write("NoqeriOS: IPv4 DHCP packet validation fixture failed\n")
    }
    if dns_fixture_self_test() {
        serial_write("NoqeriOS: DNS wire parser fixture passed\n")
    } else {
        serial_write("NoqeriOS: DNS wire parser fixture failed\n")
    }
    let activeNetwork: *Network = network_boot_probe()
    if splashActive { boot_splash_update(multibootInfo, 79 as usize) }

    arch_interrupts_init()
    arch_sti()
    let ticks: usize = arch_timer_ticks()
    let timerStart: u64 = arch_read_tsc()
    // A real UEFI PC may have its legacy PIC masked or routed through an
    // IOAPIC. Never HLT forever waiting for a PIT IRQ that cannot arrive.
    while ticks < (3 as usize) && arch_read_tsc() - timerStart < (1500000000 as u64) {
        arch_pause()
        ticks = arch_timer_ticks()
    }
    arch_cli()
    if ticks >= (3 as usize) {
        serial_write("NoqeriOS: IDT and PIT timer interrupts active\n")
    } else {
        serial_write("NoqeriOS: PIT interrupts unavailable; continuing in polled mode\n")
    }

    if splashActive { boot_splash_update(multibootInfo, 89 as usize) }

    if arch_userspace_init() {
        if arch_enter_user_test() {
            if arch_user_test_seen() {
                serial_write("NoqeriOS: ring-3 transition and syscall gate active\n")
                serial_write("NoqeriOS: ring-3 syscall reached Noqeri dispatcher\n")
            } else {
                serial_write("NoqeriOS: ring-3 syscall return was not observed\n")
            }
        } else {
            serial_write("NoqeriOS: ring-3 transition failed\n")
        }
    } else {
        serial_write("NoqeriOS: TSS/userspace initialization failed\n")
    }

    // Probe VirtIO GPU, but keep CPU framebuffer composition until native
    // resource creation, DMA and fence handling are implemented.
    let gpuLocation: u32 = 65536 as u32
    let gpuPage: usize = arch_alloc_page()
    if gpuPage != (0 as usize) {
        let gpu: *GpuCapability = gpuPage as *GpuCapability
        if gpu_detect(gpu) {
            if gpu_query_display(gpu.pciLocation) {
                serial_write("NoqeriOS: VirtIO GPU control queue display-info handshake passed\n")
                gpuLocation = gpu.pciLocation
            } else {
                serial_write("NoqeriOS: VirtIO GPU commands unavailable; CPU fallback active\n")
            }
            serial_write("NoqeriOS: GPU scanout not enabled; CPU display fallback active\n")
        } else {
            serial_write("NoqeriOS: no native GPU backend; CPU display active\n")
        }
    }
    let desktop: *GuiDesktop = null
    if framebuffer_probe(multibootInfo) {
        serial_write("NoqeriOS: 32-bit framebuffer discovered\n")
        if splashActive {
            // All boot dependencies are initialized; desktop paint replaces
            // this final frame, without a blank-screen transition.
            boot_splash_update(multibootInfo, 100 as usize)
            serial_write("NoqeriOS: framebuffer MMIO write succeeded\n")
        } else if framebuffer_draw_boot_mark(multibootInfo) {
            serial_write("NoqeriOS: framebuffer MMIO write succeeded\n")
        }
        if memoryReady {
            desktop = gui_open(multibootInfo)
            if desktop != null {
                gui_attach_files(desktop, explorerFiles as usize)
                if gpuLocation != (65536 as u32) && pmmAddress != (0 as usize) {
                    let pixelBytes: usize = desktop.width * desktop.height * (4 as usize)
                    let pages: usize = (pixelBytes + (4095 as usize)) / (4096 as usize)
                    let physicalBuffer: usize = pmm_alloc_contiguous(pmmAddress as *PhysicalMemoryManager, pages)
                    if physicalBuffer != (0 as usize) &&
                       physicalBuffer + pixelBytes <= (1073741824 as usize) {
                        let display: *GpuDisplay = gpu_display_start(gpuLocation, physicalBuffer, desktop.width, desktop.height)
                        if display != null {
                            if gui_enable_gpu(desktop, display as usize, physicalBuffer) {
                                serial_write("NoqeriOS: VirtIO GPU 2D scanout and DMA presentation active\n")
                            } else {
                                serial_write("NoqeriOS: GPU present failed; GOP CPU fallback active\n")
                            }
                        } else {
                            serial_write("NoqeriOS: GPU setup failed; GOP CPU fallback active\n")
                        }
                    } else {
                        serial_write("NoqeriOS: GPU backing allocation failed; GOP CPU fallback active\n")
                    }
                }
                serial_write("NoqeriOS: GUI compositor frame presented\n")
                serial_write("NoqeriOS: PS/2 keyboard navigation enabled when present\n")
            }
        }
    } else {
        serial_write("NoqeriOS: no supported framebuffer; serial remains active\n")
    }

    serial_write("NoqeriOS: modular monolith core services online\n")
    serial_write("NoqeriOS: bootstrap milestone complete\n")
    terminal_run(activeNetwork, desktop, explorerFiles as usize)
    while true { arch_halt() }
}
