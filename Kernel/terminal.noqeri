module os.kernel.terminal
import "../Arch/x86_64/api.noqeri"
import "../Drivers/serial.noqeri"
import "net/ipv4.noqeri"
import "net/dns.noqeri"
import "net/tcp.noqeri"
import "gui.noqeri"

// Polling COM1 terminal. Single-key commands keep the first boot shell
// independent of heap allocation, interrupts, and filesystems.
function terminal_read_key(network: *Network, desktop: *GuiDesktop): u8 {
    let spins: usize = 0 as usize
    while (arch_in8(1021 as u16) % (2 as u8)) == (0 as u8) {
        arch_pause()
        spins = spins + (1 as usize)
        if spins == (8192 as usize) {
            network_service_poll(network)
            gui_keyboard_poll(desktop)
            spins = 0 as usize
        }
    }
    return arch_in8(1016 as u16)
}

function terminal_prompt(): void {
    serial_write("\nnoqerios> ")
}

function terminal_run(network: *Network, desktop: *GuiDesktop): void {
    serial_write("\nNoqeriOS serial terminal ready (COM1)\n")
    serial_write("h=help, i=info, m=memory, p=processes, n=network, g=gateway ping, d=DNS example.com, t=local TCP probe, a/s/z=GUI focus, f=Explorer, j/k=select, e/b=folder nav, c=clear, r=reboot hint\n")
    terminal_prompt()
    while true {
        let key: u8 = terminal_read_key(network, desktop)
        if key == (104 as u8) || key == (72 as u8) {
            serial_write("\nCommands: h help | i info | m memory | p processes | n network | g gateway ping | d DNS example.com | t TCP fixture | a/s/z GUI | f Explorer | j/k select | e/b folder | c clear | r reboot\n")
            terminal_prompt()
        } else if key == (105 as u8) || key == (73 as u8) {
            serial_write("\nNoqeriOS experimental x86_64 kernel; Noqeri native services\n")
            terminal_prompt()
        } else if key == (109 as u8) || key == (77 as u8) {
            serial_write("\nMemory: physical allocator and virtual memory initialized at boot\n")
            terminal_prompt()
        } else if key == (112 as u8) || key == (80 as u8) {
            serial_write("\nProcesses: kernel scheduler initialized; interactive user processes pending\n")
            terminal_prompt()
        } else if key == (110 as u8) || key == (78 as u8) {
            serial_write("\n")
            network_console_status(network)
            terminal_prompt()
        } else if key == (103 as u8) || key == (71 as u8) {
            if network == null || !network.online {
                serial_write("\nNetwork: no configured gateway\n")
            } else if network_icmp_echo(network) {
                serial_write("\nNetwork: IPv4 gateway ICMP echo succeeded\n")
            } else {
                serial_write("\nNetwork: gateway ICMP echo timed out\n")
            }
            terminal_prompt()
        } else if key == (100 as u8) || key == (68 as u8) {
            if network == null || !network.online {
                serial_write("\nDNS: network offline\n")
            } else {
                let resolved: u32 = network_dns_example(network)
                if resolved == (0 as u32) {
                    serial_write("\nDNS: example.com A lookup unavailable\n")
                } else {
                    serial_write("\nDNS: example.com A = ")
                    network_console_ip(resolved)
                    serial_write("\n")
                }
            }
            terminal_prompt()
        } else if key == (116 as u8) || key == (84 as u8) {
            if network == null || !network.online {
                serial_write("\nTCP: network offline\n")
            } else if tcp_fixture_request(network) {
                serial_write("\nTCP: local HTTP fixture response verified\n")
            } else {
                serial_write("\nTCP: local HTTP fixture unavailable\n")
            }
            terminal_prompt()
        } else if key == (97 as u8) || key == (65 as u8) ||
                  key == (115 as u8) || key == (83 as u8) ||
                  key == (122 as u8) || key == (90 as u8) ||
                  key == (102 as u8) || key == (70 as u8) ||
                  key == (106 as u8) || key == (74 as u8) ||
                  key == (107 as u8) || key == (75 as u8) ||
                  key == (101 as u8) || key == (69 as u8) ||
                  key == (98 as u8) || key == (66 as u8) {
            if !gui_key(desktop, key) {
                serial_write("\nGUI: no active graphical desktop\n")
            } else {
                serial_write("\nGUI: focus changed\n")
            }
            terminal_prompt()
        } else if key == (99 as u8) || key == (67 as u8) {
            serial_write("\x1b[2J\x1b[H")
            terminal_prompt()
        } else if key == (114 as u8) || key == (82 as u8) {
            serial_write("\nReboot requires QEMU reset; no destructive action was performed\n")
            terminal_prompt()
        }
    }
}
