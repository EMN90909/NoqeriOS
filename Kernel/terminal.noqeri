module os.kernel.terminal
import "../Arch/x86_64/api.noqeri"
import "../Drivers/serial.noqeri"
import "net/ipv4.noqeri"
import "net/dns.noqeri"
import "net/tcp.noqeri"
import "gui.noqeri"
import "file_manager.noqeri"
import "noed.noqeri"

// Noqeri Shell v1. Bounded line input and a CMD-inspired, case-insensitive
// command dispatcher. Commands execute only after Enter, never per keystroke.
// Filesystem operations use the mounted NoqFS Explorer; all are read-only.
function shell_putchar(ch: u8): void {
    let attempts: usize = 0 as usize
    while ((arch_in8(1021 as u16) / (32 as u8)) % (2 as u8)) == (0 as u8) &&
          attempts < (100000 as usize) {
        arch_pause()
        attempts = attempts + (1 as usize)
    }
    if attempts < (100000 as usize) {
        arch_out8(1016 as u16, ch)
        arch_console_echo(ch)
    }
}

function shell_print(data: *u8, length: usize): void {
    if data == null { return }
    let i: usize = 0 as usize
    while i < length {
        shell_putchar(data[i])
        i = i + (1 as usize)
    }
}
function shell_number(number: u64): void {
    // Allocation-free decimal output, safe even for large directory listings.
    let place: u64 = 1 as u64
    while number / place >= (10 as u64) &&
          place < (1000000000000000000 as u64) {
        place = place * (10 as u64)
    }
    while place > (0 as u64) {
        shell_putchar((48 as u8) + (((number / place) % (10 as u64)) as u8))
        place = place / (10 as u64)
    }
}
function shell_word_hash(bytes: *u8, length: usize): u32 {
    let value: u32 = 5381 as u32
    let i: usize = 0 as usize
    while i < length {
        let ch: u8 = bytes[i]
        if ch >= (65 as u8) && ch <= (90 as u8) { ch = ch + (32 as u8) }
        value = (value * (33 as u32)) + (ch as u32)
        i = i + (1 as usize)
    }
    return value
}
function shell_name_match(a: *u8, b: *u8, length: usize): bool {
    let i: usize = 0 as usize
    while i < length {
        let left: u8 = a[i]
        let right: u8 = b[i]
        if left >= (65 as u8) && left <= (90 as u8) { left = left + (32 as u8) }
        if right >= (65 as u8) && right <= (90 as u8) { right = right + (32 as u8) }
        if left != right { return false }
        i = i + (1 as usize)
    }
    return true
}
function shell_find(m: *FileManager, input: *u8, length: usize): isize {
    if m == null || length == (0 as usize) { return -1 as isize }
    let i: usize = 0 as usize
    while i < m.visibleCount {
        let index: usize = m.visible[i] as usize
        let name: *u8 = m.names + index * (25 as usize)
        let j: usize = 0 as usize
        while j < (24 as usize) && name[j] != (0 as u8) {
            j = j + (1 as usize)
        }
        if j == length && shell_name_match(name, input, length) { return i as isize }
        i = i + (1 as usize)
    }
    return -1 as isize
}
function shell_prompt(): void { serial_write("\nN:\\> ") }

function shell_exec(buffer: *u8, size: usize, network: *Network, desktop: *GuiDesktop, filesAddress: usize): void {
    let start: usize = 0 as usize
    while start < size && buffer[start] == (32 as u8) { start = start + (1 as usize) }
    let cmdEnd: usize = start
    while cmdEnd < size && buffer[cmdEnd] != (32 as u8) { cmdEnd = cmdEnd + (1 as usize) }
    let args: usize = cmdEnd
    while args < size && buffer[args] == (32 as u8) { args = args + (1 as usize) }
    if start == size { return }
    let hash: u32 = shell_word_hash(buffer + start, cmdEnd - start)
    let m: *FileManager = filesAddress as *FileManager

    if hash == (2090324718 as u32) || hash == (177677 as u32) {
        serial_write("\nNoqeri Shell - Windows-style, fewer commands\n")
        serial_write("help  cls/clear  ver/info  mem  tasks  net  ping  dns  tcp\n")
        serial_write("dir/ls/list  cd/go NAME  up/back  pwd/where\n\n")
        serial_write("files  start  gui  reboot  noed inspect FILE.EXE\n")
        serial_write("NoqFS browsing is read-only. Press Enter to run.\n")
    } else if hash == (2090550987 as u32) {
        if args == size {
            serial_write("\nNoed Windows compatibility layer\n")
            serial_write("Usage: noed inspect FILE.EXE | noed run FILE.EXE\n")
            serial_write("Only PE32+ x64 file inspection is available today.\n")
        } else {
            let actionEnd: usize = args
            while actionEnd < size && buffer[actionEnd] != (32 as u8) {
                actionEnd = actionEnd + (1 as usize)
            }
            let fileStart: usize = actionEnd
            while fileStart < size && buffer[fileStart] == (32 as u8) {
                fileStart = fileStart + (1 as usize)
            }
            if m == null {
                serial_write("\nNoed: NoqFS volume is not mounted\n")
            } else if fileStart == size {
                serial_write("\nNoed: specify a filename\n")
            } else {
                let item: isize = shell_find(m, buffer + fileStart, size - fileStart)
                if item < (0 as isize) {
                    serial_write("\nNoed: file not found\n")
                } else if shell_word_hash(buffer + args, actionEnd - args) != (2673485051 as u32) &&
                          shell_word_hash(buffer + args, actionEnd - args) != (193505114 as u32) {
                    serial_write("\nNoed: use inspect or run\n")
                } else {
                    m.selected = item as usize
                    let index: usize = m.visible[m.selected] as usize
                    if m.flags[index] != (1 as u32) {
                        serial_write("\nNoed: selected entry is not a file\n")
                    } else {
                        let page: usize = arch_alloc_page()
                        if page == (0 as usize) { serial_write("\nNoed: out of memory\n") }
                        else {
                            let count: usize = files_read_selected(m as usize, page, 4096 as usize)
                            serial_write("\n")
                            noed_report(noed_validate_pe(page, count, m.sizes[index] as usize))
                        }
                    }
                }
            }
        }
    } else if hash == (193488487 as u32) || hash == (255552908 as u32) {
        serial_write("\x1b[2J\x1b[H")
    } else if hash == (193508946 as u32) || hash == (2090370257 as u32) || hash == (2090370257 as u32) {
        serial_write("\nNoqeriOS x86_64, native Noqeri shell 1.0\n")
    } else if hash == (193499140 as u32) || hash == (226666718 as u32) {
        serial_write("\nPhysical allocator, VMM and kernel heap initialized\n")
    } else if hash == (275333835 as u32) || hash == (5863720 as u32) {
        serial_write("\nKernel scheduler online; general user tasks not yet launchable\n")
    } else if hash == (193500236 as u32) || hash == (190120623 as u32) {
        serial_write("\n")
        network_console_status(network)
    } else if hash == (2090616627 as u32) {
        if network == null || !network.online { serial_write("\nNetwork: no configured gateway\n") }
        else if network_icmp_echo(network) { serial_write("\nNetwork: IPv4 gateway ICMP echo succeeded\n") }
        else { serial_write("\nNetwork: gateway ICMP echo timed out\n") }
    } else if hash == (193489642 as u32) {
        if network == null || !network.online { serial_write("\nDNS: network offline\n") }
        else {
            let resolved: u32 = network_dns_example(network)
            if resolved == (0 as u32) { serial_write("\nDNS: example.com A lookup unavailable\n") }
            else {
                serial_write("\nDNS: example.com A = ")
                network_console_ip(resolved)
                serial_write("\n")
            }
        }
    } else if hash == (193506700 as u32) {
        if network == null || !network.online { serial_write("\nTCP: network offline\n") }
        else if tcp_fixture_request(network) { serial_write("\nTCP: local HTTP fixture response verified\n") }
        else { serial_write("\nTCP: local HTTP fixture unavailable\n") }
    } else if hash == (193489476 as u32) || hash == (5863588 as u32) || hash == (2090473057 as u32) {
        if m == null { serial_write("\nNoqFS drive not mounted\n") }
        else {
            serial_write("\n Directory of N:\\ (read-only)\n")
            let i: usize = 0 as usize
            while i < m.visibleCount {
                let index: usize = m.visible[i] as usize
                if m.flags[index] == (2 as u32) { serial_write(" <DIR>  ") }
                else {
                    shell_number(m.sizes[index])
                    serial_write(" B  ")
                }
                let name: *u8 = m.names + index * (25 as usize)
                let n: usize = 0 as usize
                while n < (24 as usize) && name[n] != (0 as u8) { n = n + (1 as usize) }
                shell_print(name,n)
                serial_write("\n")
                i = i + (1 as usize)
            }
            serial_write("Items: ")
            shell_number(m.visibleCount as u64)
            serial_write("\n")
        }
    } else if hash == (193502992 as u32) || hash == (279128128 as u32) {
        serial_write("\nN:\\")
        if m != null && m.currentParent != (0 as u64) {
            serial_write("KEY-")
            shell_number(m.currentParent)
        }
        serial_write("\n")
    } else if hash == (5863276 as u32) || hash == (5863419 as u32) || hash == (5863882 as u32) || hash == (2090104438 as u32) {
        if m == null { serial_write("\nNoqFS drive not mounted\n") }
        else if hash == (5863882 as u32) || hash == (2090104438 as u32) {
            if !files_back(m) { serial_write("\nAlready at root\n") }
        } else if args == size { serial_write("\nUsage: cd FOLDER, go FOLDER, up or back\n") }
        else if size - args == (2 as usize) && buffer[args] == (46 as u8) && buffer[args + (1 as usize)] == (46 as u8) {
            if !files_back(m) { serial_write("\nAlready at root\n") }
        } else {
            let item: isize = shell_find(m, buffer + args, size - args)
            if item < (0 as isize) { serial_write("\nFolder not found\n") }
            else {
                m.selected = item as usize
                if !files_enter(m) { serial_write("\nNot a directory\n") }
            }
        }
        if desktop != null && desktop.explorerVisible { gui_paint(desktop) }
    } else if hash == (2090777863 as u32) || hash == (193488125 as u32) || hash == (2090683713 as u32) {
        if m == null { serial_write("\nNoqFS drive not mounted\n") }
        else if args == size { serial_write("\nUsage: type FILENAME\n") }
        else {
            let item: isize = shell_find(m,buffer + args,size - args)
            if item < (0 as isize) { serial_write("\nFile not found\n") }
            else {
                m.selected = item as usize
                let scratch: usize = arch_alloc_page()
                if scratch == (0 as usize) { serial_write("\nOut of memory\n") }
                else {
                    let count: usize = files_read_selected(m as usize,scratch,(512 as usize))
                    serial_write("\n")
                    shell_print(scratch as *u8,count)
                    serial_write("\n")
                    if count == (512 as usize) { serial_write("(preview limited to 512 bytes)\n") }
                }
            }
        }
    } else if hash == (2090214596 as u32) || hash == (193505554 as u32) {
        serial_write("\n")
        shell_print(buffer + args,size - args)
        serial_write("\n")
    } else if hash == (259010616 as u32) || hash == (274811347 as u32) {
        if desktop == null { serial_write("\nGraphical desktop unavailable\n") }
        else {
            desktop.explorerVisible = true
            gui_paint(desktop)
            serial_write("\nFile Explorer opened\n")
        }
    } else if hash == (193493130 as u32) {
        if desktop == null { serial_write("\nGraphical desktop unavailable\n") }
        else { gui_key(desktop, 115 as u8); serial_write("\nStart selection changed\n") }
    } else if hash == (421948272 as u32) {
        serial_write("\nReboot is not implemented; use QEMU reset\n")
    } else {
        serial_write("\nUnknown command. Type help.\n")
    }
}

function terminal_read_key(network: *Network, desktop: *GuiDesktop): u8 {
    let spins: usize = 0 as usize
    while (arch_in8(1021 as u16) % (2 as u8)) == (0 as u8) {
        arch_pause()
        spins = spins + (1 as usize)
        if spins == (8192 as usize) {
            network_service_poll(network)
            gui_keyboard_poll(desktop)
            let graphicalKey: u8 = gui_terminal_take_key(desktop)
            if graphicalKey != (0 as u8) { return graphicalKey }
            spins = 0 as usize
        }
    }
    return arch_in8(1016 as u16)
}

function terminal_run(network: *Network, desktop: *GuiDesktop, filesAddress: usize): void {
    serial_write("\nNoqeriOS serial terminal ready (COM1)\n")
    serial_write("Noqeri Shell 1.0. Enter help for commands.\n")
    let inputPage: usize = arch_alloc_page()
    if inputPage == (0 as usize) {
        serial_write("Shell: input allocation failed\n")
        while true { arch_halt() }
    }
    let historyPage: usize = arch_alloc_page()
    if historyPage == (0 as usize) {
        serial_write("Shell: history allocation failed\n")
        while true { arch_halt() }
    }
    let history: *u8 = historyPage as *u8
    let historyLength: usize = 0 as usize
    let input: *u8 = inputPage as *u8
    let count: usize = 0 as usize
    shell_prompt()
    while true {
        let key: u8 = terminal_read_key(network,desktop)
        if key == (13 as u8) || key == (10 as u8) {
            if key == (10 as u8) && count == (0 as usize) { continue }
            serial_write("\n")
            let commandLength: usize = count
            if shell_word_hash(input, commandLength) == (252997285 as u32) {
                if historyLength == (0 as usize) {
                    serial_write("No previous command.\n")
                } else {
                    shell_exec(history,historyLength,network,desktop,filesAddress)
                }
            } else {
                if commandLength > (0 as usize) {
                    let index: usize = 0 as usize
                    while index < commandLength {
                        history[index] = input[index]
                        index = index + (1 as usize)
                    }
                    historyLength = commandLength
                }
                shell_exec(input,commandLength,network,desktop,filesAddress)
            }
            count = 0 as usize
            shell_prompt()
            gui_terminal_redraw(desktop)
        } else if key == (8 as u8) || key == (127 as u8) {
            if count > (0 as usize) {
                count = count - (1 as usize)
                serial_write("\b \b")
            }
        } else if key >= (32 as u8) && key <= (126 as u8) {
            if count < (127 as usize) {
                input[count] = key
                count = count + (1 as usize)
                shell_putchar(key)
                gui_terminal_redraw(desktop)
            } else {
                shell_putchar(7 as u8)
            }
        }
    }
}
