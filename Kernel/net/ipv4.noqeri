module os.kernel.net.ipv4

import "../../Drivers/virtio_net.noqeri"
import "../../Drivers/e1000.noqeri"
import "../../Drivers/rtl8139.noqeri"
import "../../Drivers/serial.noqeri"
import "../../Drivers/pci.noqeri"
import "../../Arch/x86_64/api.noqeri"

// Minimal bounded Ethernet/ARP/IPv4/UDP/DHCP/ICMP bootstrap.
// Single polling NIC; no TCP, IPv6, DNS resolver, TLS or fragmentation.
record Network {
    nic: *VirtioNet;
    intel: *E1000;
    realtek: *Rtl8139;
    mac: *u8;
    adapterKind: u32;
    frame: usize;
    rx: usize;
    payload: usize;
    routerMac: *u8;
    ip: u32;
    mask: u32;
    gateway: u32;
    dns: u32;
    offer: u32;
    server: u32;
    dhcpXid: u32;
    dhcpType: u8;
    online: bool;
}

// The IPv4 stack uses a transport-neutral L2 interface. v1=VirtIO-net,
// v2=Intel 82540EM e1000. Keep buffers stable for DMA and never reinitialize
// a device while a packet is outstanding.
function network_send(n: *Network, frame: usize, length: usize): bool {
    if n.adapterKind == (1 as u32) { return virtio_net_send(n.nic, frame, length) }
    if n.adapterKind == (2 as u32) { return e1000_send(n.intel, frame, length) }
    if n.adapterKind == (3 as u32) { return rtl8139_send(n.realtek, frame, length) }
    return false
}
function network_receive(n: *Network, output: usize, capacity: usize, timeout: usize): usize {
    if n.adapterKind == (1 as u32) { return virtio_net_receive(n.nic, output, capacity, timeout) }
    if n.adapterKind == (2 as u32) { return e1000_receive(n.intel, output, capacity, timeout) }
    if n.adapterKind == (3 as u32) { return rtl8139_receive(n.realtek, output, capacity, timeout) }
    return 0 as usize
}
function network_close(n: *Network): void {
    if n.adapterKind == (1 as u32) { virtio_net_close(n.nic) }
    if n.adapterKind == (2 as u32) { e1000_close(n.intel) }
    if n.adapterKind == (3 as u32) { rtl8139_close(n.realtek) }
    n.online = false
}

// QEMU port 0xe9 diagnostic: fixed-width hexadecimal fields, avoiding
// libc formatting in the freestanding kernel. Logs only DHCP and ARP details.
function network_trace_hex(value: u32): void {
    let divisor: u32 = 268435456 as u32
    let i: usize = 0 as usize
    while i < (8 as usize) {
        let digit: u32 = (value / divisor) % (16 as u32)
        let ascii: u8 = 0 as u8
        if digit < (10 as u32) {
            ascii = (48 as u32 + digit) as u8
        } else {
            ascii = (55 as u32 + digit) as u8
        }
        arch_out8(233 as u16, ascii)
        if divisor > (1 as u32) { divisor = divisor / (16 as u32) }
        i = i + (1 as usize)
    }
    arch_out8(233 as u16, 10 as u8)
}
function network_byte(base: usize, offset: usize): u8 {
    let ptr: *u8 = base as *u8
    return ptr[offset]
}
function network_put(base: usize, offset: usize, value: u8): void {
    let ptr: *u8 = base as *u8
    ptr[offset] = value
}
function network_read16(base: usize, offset: usize): u16 {
    return ((network_byte(base, offset) as u16) * (256 as u16)) +
           (network_byte(base, offset + (1 as usize)) as u16)
}
function network_write16(base: usize, offset: usize, value: u16): void {
    network_put(base, offset, (value / (256 as u16)) as u8)
    network_put(base, offset + (1 as usize), (value % (256 as u16)) as u8)
}
function network_read32(base: usize, offset: usize): u32 {
    return ((network_byte(base, offset) as u32) * (16777216 as u32)) +
           ((network_byte(base, offset + (1 as usize)) as u32) * (65536 as u32)) +
           ((network_byte(base, offset + (2 as usize)) as u32) * (256 as u32)) +
           (network_byte(base, offset + (3 as usize)) as u32)
}
function network_write32(base: usize, offset: usize, value: u32): void {
    network_put(base, offset, (value / (16777216 as u32)) as u8)
    network_put(base, offset + (1 as usize), ((value / (65536 as u32)) % (256 as u32)) as u8)
    network_put(base, offset + (2 as usize), ((value / (256 as u32)) % (256 as u32)) as u8)
    network_put(base, offset + (3 as usize), (value % (256 as u32)) as u8)
}
function network_fill(base: usize, start: usize, count: usize, value: u8): void {
    let i: usize = 0 as usize
    while i < count {
        network_put(base, start + i, value)
        i = i + (1 as usize)
    }
}
function network_copy(out: usize, target: usize, source: usize, start: usize, count: usize): void {
    let i: usize = 0 as usize
    while i < count {
        network_put(out, target + i, network_byte(source, start + i))
        i = i + (1 as usize)
    }
}
function network_checksum(base: usize, start: usize, count: usize): u16 {
    let sum: u32 = 0 as u32
    let i: usize = 0 as usize
    while i < count {
        let hi: u32 = network_byte(base, start + i) as u32
        let lo: u32 = 0 as u32
        if i + (1 as usize) < count {
            lo = network_byte(base, start + i + (1 as usize)) as u32
        }
        sum = sum + hi * (256 as u32) + lo
        i = i + (2 as usize)
    }
    while sum > (65535 as u32) {
        sum = (sum % (65536 as u32)) + (sum / (65536 as u32))
    }
    return ((65535 as u32) - sum) as u16
}
function network_ethernet(n: *Network, targetMac: usize, etherType: u16): void {
    network_copy(n.frame, 0 as usize, targetMac, 0 as usize, 6 as usize)
    network_copy(n.frame, 6 as usize, n.mac as usize, 0 as usize, 6 as usize)
    network_write16(n.frame, 12 as usize, etherType)
}
function network_ipv4(n: *Network, targetMac: usize, src: u32, dst: u32, protocol: u8,
                      payloadLength: usize): bool {
    if payloadLength > (1480 as usize) { return false }
    network_ethernet(n, targetMac, 2048 as u16)
    network_put(n.frame, 14 as usize, 69 as u8) // IPv4, IHL 5
    network_put(n.frame, 15 as usize, 0 as u8)
    network_write16(n.frame, 16 as usize, (20 as usize + payloadLength) as u16)
    network_write16(n.frame, 18 as usize, 0x4e51 as u16)
    network_write16(n.frame, 20 as usize, 16384 as u16) // DF; no fragments
    network_put(n.frame, 22 as usize, 64 as u8)
    network_put(n.frame, 23 as usize, protocol)
    network_write16(n.frame, 24 as usize, 0 as u16)
    network_write32(n.frame, 26 as usize, src)
    network_write32(n.frame, 30 as usize, dst)
    network_write16(n.frame, 24 as usize, network_checksum(n.frame, 14 as usize, 20 as usize))
    return true
}
function network_udp_send(n: *Network, targetMac: usize, dstIp: u32,
                          srcPort: u16, dstPort: u16, payloadSize: usize): bool {
    if payloadSize > (1472 as usize) { return false }
    if !network_ipv4(n, targetMac, n.ip, dstIp, 17 as u8, payloadSize + (8 as usize)) {
        return false
    }
    network_write16(n.frame, 34 as usize, srcPort)
    network_write16(n.frame, 36 as usize, dstPort)
    network_write16(n.frame, 38 as usize, (payloadSize + (8 as usize)) as u16)
    network_write16(n.frame, 40 as usize, 0 as u16) // UDP checksum optional for IPv4
    network_copy(n.frame, 42 as usize, n.payload, 0 as usize, payloadSize)
    return network_send(n, n.frame, payloadSize + (42 as usize))
}
function network_dhcp_send(n: *Network, kind: u8): bool {
    network_fill(n.payload, 0 as usize, 320 as usize, 0 as u8)
    network_put(n.payload, 0 as usize, 1 as u8) // BOOTREQUEST
    network_put(n.payload, 1 as usize, 1 as u8) // Ethernet
    network_put(n.payload, 2 as usize, 6 as u8)
    network_write32(n.payload, 4 as usize, n.dhcpXid) // current transaction ID
    network_write16(n.payload, 10 as usize, 32768 as u16) // broadcast flag
    network_copy(n.payload, 28 as usize, n.mac as usize, 0 as usize, 6 as usize)
    network_write32(n.payload, 236 as usize, 0x63825363 as u32) // magic cookie
    network_put(n.payload, 240 as usize, 53 as u8)
    network_put(n.payload, 241 as usize, 1 as u8)
    network_put(n.payload, 242 as usize, kind)
    let option: usize = 243 as usize
    if kind == (3 as u8) {
        network_put(n.payload, option, 50 as u8)
        network_put(n.payload, option + (1 as usize), 4 as u8)
        network_write32(n.payload, option + (2 as usize), n.offer)
        option = option + (6 as usize)
        network_put(n.payload, option, 54 as u8)
        network_put(n.payload, option + (1 as usize), 4 as u8)
        network_write32(n.payload, option + (2 as usize), n.server)
        option = option + (6 as usize)
    }
    network_put(n.payload, option, 55 as u8)
    network_put(n.payload, option + (1 as usize), 3 as u8)
    network_put(n.payload, option + (2 as usize), 1 as u8)
    network_put(n.payload, option + (3 as usize), 3 as u8)
    network_put(n.payload, option + (4 as usize), 6 as u8)
    network_put(n.payload, option + (5 as usize), 255 as u8)
    let broadcast: usize = n.frame + (2048 as usize)
    // n.frame is a page; use its end as a transient FF:FF:FF:FF:FF:FF MAC.
    network_fill(broadcast, 0 as usize, 6 as usize, 255 as u8)
    return network_udp_send(n, broadcast, 4294967295 as u32,
                            68 as u16, 67 as u16, 300 as usize)
}
// A shared bounded IPv4 receive contract for DHCP/ICMP/TCP/DNS.
// Returns the byte length of the IPv4 header, or zero on invalid packets.
// No IPv4 reassembly: reject both MF and nonzero fragment offsets. The
// caller must additionally check protocol endpoints and transport lengths.
function network_ipv4_header(frame: usize, bytes: usize, protocol: u8): usize {
    if frame == (0 as usize) || bytes < (34 as usize) ||
       bytes > (2048 as usize) ||
       network_read16(frame, 12 as usize) != (2048 as u16) {
        return 0 as usize
    }
    let versionIhl: u8 = network_byte(frame, 14 as usize)
    if (versionIhl as usize) / (16 as usize) != (4 as usize) {
        return 0 as usize
    }
    let headerSize: usize = ((versionIhl as usize) % (16 as usize)) * (4 as usize)
    if headerSize < (20 as usize) || headerSize > (60 as usize) ||
       headerSize > bytes - (14 as usize) {
        return 0 as usize
    }
    let total: usize = network_read16(frame, 16 as usize) as usize
    if total < headerSize || total > bytes - (14 as usize) ||
       total > (1500 as usize) ||
       network_byte(frame, 23 as usize) != protocol ||
       network_byte(frame, 22 as usize) == (0 as u8) ||
       network_read16(frame, 20 as usize) % (16384 as u16) != (0 as u16) ||
       network_checksum(frame, 14 as usize, headerSize) != (0 as u16) {
        return 0 as usize
    }
    return headerSize
}

function network_is_dhcp(n: *Network, bytes: usize): bool {
    if n == null || bytes < (42 as usize + 240 as usize) { return false }
    let ipBytes: usize = network_ipv4_header(n.rx, bytes, 17 as u8)
    if ipBytes == (0 as usize) { return false }
    let ipTotal: usize = network_read16(n.rx, 16 as usize) as usize
    if ipTotal < ipBytes + (8 as usize) + (240 as usize) { return false }
    let udpOffset: usize = (14 as usize) + ipBytes
    if network_read16(n.rx, udpOffset) != (67 as u16) ||
       network_read16(n.rx, udpOffset + (2 as usize)) != (68 as u16) {
        return false
    }
    let udpLength: usize = network_read16(n.rx, udpOffset + (4 as usize)) as usize
    if udpLength < (248 as usize) ||
       udpLength > ipTotal - ipBytes ||
       udpOffset + udpLength > bytes {
        return false
    }
    let dhcp: usize = udpOffset + (8 as usize)
    let end: usize = udpOffset + udpLength
    if network_byte(n.rx, dhcp) != (2 as u8) ||
       network_byte(n.rx, dhcp + (1 as usize)) != (1 as u8) ||
       network_byte(n.rx, dhcp + (2 as usize)) != (6 as u8) ||
       network_read32(n.rx, dhcp + (4 as usize)) != n.dhcpXid ||
       network_read32(n.rx, dhcp + (236 as usize)) != (0x63825363 as u32) {
        return false
    }
    let i: usize = 0 as usize
    while i < (6 as usize) {
        if network_byte(n.rx, dhcp + (28 as usize) + i) != n.mac[i] {
            return false
        }
        i = i + (1 as usize)
    }
    let offered: u32 = network_read32(n.rx, dhcp + (16 as usize))
    let option: usize = dhcp + (240 as usize)
    let message: u8 = 0 as u8
    let terminated: bool = false
    let server: u32 = 0 as u32
    let mask: u32 = 0 as u32
    let router: u32 = 0 as u32
    let dns: u32 = 0 as u32
    while option < end {
        let tag: u8 = network_byte(n.rx, option)
        if tag == (255 as u8) {
            terminated = true
            break
        }
        if tag == (0 as u8) {
            option = option + (1 as usize)
        } else {
            if option + (2 as usize) > end { return false }
            let size: usize = network_byte(n.rx, option + (1 as usize)) as usize
            if size > (end - option - (2 as usize)) { return false }
            if tag == (53 as u8) && size == (1 as usize) {
                message = network_byte(n.rx, option + (2 as usize))
            }
            if size >= (4 as usize) {
                let value: u32 = network_read32(n.rx, option + (2 as usize))
                if tag == (54 as u8) { server = value }
                if tag == (1 as u8) { mask = value }
                if tag == (3 as u8) { router = value }
                if tag == (6 as u8) { dns = value }
            }
            option = option + (2 as usize) + size
        }
    }
    // RFC 2131 requires an explicit End option. Do not accept a partial
    // option stream that happens to contain a valid OFFER or ACK.
    if !terminated { return false }
    // Only DHCP offers and ACKs with a valid server identity may update
    // the current lease. Unrelated or malformed traffic must not move state.
    if offered == (0 as u32) || server == (0 as u32) { return false }
    if message == (2 as u8) {
        n.offer = offered
        n.server = server
        n.dhcpType = message
        return true
    }
    if message == (5 as u8) && offered == n.offer && server == n.server {
        n.ip = offered
        n.mask = mask
        n.gateway = router
        n.dns = dns
        n.dhcpType = message
        return true
    }
    return false
}
function network_dhcp(n: *Network): bool {
    // Bounded retries; boot must continue when no DHCP server is present.
    let attempt: usize = 0 as usize
    while attempt < (3 as usize) {
        // Do not allow a previous attempt's OFFER or ACK to satisfy a new
        // retry after the old one timed out.
        // TSC-derived per-attempt transaction ID avoids a constant, easily
        // replayed value. This is NOT cryptographically secure entropy.
        n.dhcpXid = (arch_read_tsc() % (4294967295 as u64)) as u32
        if n.dhcpXid == (0 as u32) { n.dhcpXid = 0x4e4f5145 as u32 }
        n.dhcpType = 0 as u8
        n.offer = 0 as u32
        n.server = 0 as u32
        n.ip = 0 as u32
        if network_dhcp_send(n, 1 as u8) {
            let rxCount: usize = 0 as usize
            while rxCount < (24 as usize) {
                let length: usize = network_receive(n, n.rx, 2048 as usize, 200000 as usize)
                if length != (0 as usize) && network_is_dhcp(n, length) &&
                   n.dhcpType == (2 as u8) { break }
                rxCount = rxCount + (1 as usize)
            }
            if n.dhcpType == (2 as u8) && network_dhcp_send(n, 3 as u8) {
                let ackCount: usize = 0 as usize
                while ackCount < (32 as usize) {
                    let length: usize = network_receive(n, n.rx, 2048 as usize, 200000 as usize)
                    if length != (0 as usize) && network_is_dhcp(n, length) &&
                       n.dhcpType == (5 as u8) && n.ip != (0 as u32) { return true }
                    ackCount = ackCount + (1 as usize)
                }
            }
        }
        attempt = attempt + (1 as usize)
    }
    return false
}
// Strictly match an awaited ARP reply to our interface and the Ethernet
// sender address. This rejects malformed/spoofed envelopes but ARP still has
// no cryptographic authentication.
function network_arp_reply_matches(n: *Network, bytes: usize, address: u32): bool {
    if n == null || bytes < (42 as usize) ||
       network_read16(n.rx, 12 as usize) != (2054 as u16) ||
       network_read16(n.rx, 14 as usize) != (1 as u16) ||
       network_read16(n.rx, 16 as usize) != (2048 as u16) ||
       network_byte(n.rx, 18 as usize) != (6 as u8) ||
       network_byte(n.rx, 19 as usize) != (4 as u8) ||
       network_read16(n.rx, 20 as usize) != (2 as u16) ||
       network_read32(n.rx, 28 as usize) != address ||
       network_read32(n.rx, 38 as usize) != n.ip {
        return false
    }
    if network_byte(n.rx, 22 as usize) % (2 as u8) != (0 as u8) { return false }
    let nonzero: bool = false
    let i: usize = 0 as usize
    while i < (6 as usize) {
        let sender: u8 = network_byte(n.rx, 22 as usize + i)
        if sender != (0 as u8) { nonzero = true }
        if sender != network_byte(n.rx, 6 as usize + i) ||
           network_byte(n.rx, 32 as usize + i) != n.mac[i] { return false }
        i = i + (1 as usize)
    }
    return nonzero
}
function network_arp_resolve(n: *Network, address: u32, destinationMac: usize): bool {
    if address == (0 as u32) || n.ip == (0 as u32) || destinationMac == (0 as usize) {
        return false
    }
    network_fill(n.frame, 0 as usize, 6 as usize, 255 as u8)
    network_ethernet(n, n.frame, 2054 as u16)
    network_write16(n.frame, 14 as usize, 1 as u16) // Ethernet
    network_write16(n.frame, 16 as usize, 2048 as u16) // IPv4
    network_put(n.frame, 18 as usize, 6 as u8)
    network_put(n.frame, 19 as usize, 4 as u8)
    network_write16(n.frame, 20 as usize, 1 as u16) // ARP request
    network_copy(n.frame, 22 as usize, n.mac as usize, 0 as usize, 6 as usize)
    network_write32(n.frame, 28 as usize, n.ip)
    network_fill(n.frame, 32 as usize, 6 as usize, 0 as u8)
    network_write32(n.frame, 38 as usize, address)
    // Ethernet minimum frame length is 60 bytes without FCS. Never send
    // stale bytes from a preceding IPv4/TCP packet as ARP padding.
    network_fill(n.frame, 42 as usize, 18 as usize, 0 as u8)
    let tries: usize = 0 as usize
    while tries < (3 as usize) {
        if !network_send(n, n.frame, 60 as usize) { return false }
        let polls: usize = 0 as usize
        while polls < (32 as usize) {
            let length: usize = network_receive(n, n.rx, 2048 as usize, 200000 as usize)
            if length >= (42 as usize) &&
               network_read16(n.rx, 12 as usize) == (2054 as u16) {
                arch_out8(233 as u16, 65 as u8) // 'A' ARP packet
                network_trace_hex(network_read16(n.rx, 20 as usize) as u32)
                network_trace_hex(network_read32(n.rx, 28 as usize))
                network_trace_hex(network_read32(n.rx, 38 as usize))
            }
            if network_arp_reply_matches(n, length, address) {
                network_copy(destinationMac, 0 as usize, n.rx, 22 as usize, 6 as usize)
                return true
            }
            polls = polls + (1 as usize)
        }
        tries = tries + (1 as usize)
    }
    return false
}
function network_arp_request(n: *Network): bool {
    arch_out8(233 as u16, 73 as u8)
    network_trace_hex(n.ip)
    arch_out8(233 as u16, 71 as u8)
    network_trace_hex(n.gateway)
    return network_arp_resolve(n, n.gateway, n.routerMac as usize)
}
// Logical bitwise AND using arithmetic, until Stage-2 bit operators
// are guaranteed on every supported Noqeri native compiler.
function network_ip_mask(value: u32, mask: u32): u32 {
    let left: u32 = value
    let right: u32 = mask
    let result: u32 = 0 as u32
    let bit: u32 = 1 as u32
    let index: usize = 0 as usize
    while index < (32 as usize) {
        if left % (2 as u32) == (1 as u32) &&
           right % (2 as u32) == (1 as u32) {
            result = result + bit
        }
        left = left / (2 as u32)
        right = right / (2 as u32)
        // Never shift past bit 31. A wrapped/trapping u32 multiply on the
        // last iteration could break subnet routing on some backends.
        if index < (31 as usize) { bit = bit * (2 as u32) }
        index = index + (1 as usize)
    }
    return result
}
function network_route_mac(n: *Network, destination: u32, output: usize): bool {
    if n == null || !n.online || output == (0 as usize) { return false }
    if n.mask != (0 as u32) &&
       network_ip_mask(destination, n.mask) == network_ip_mask(n.ip, n.mask) {
        return network_arp_resolve(n, destination, output)
    }
    if n.gateway == (0 as u32) { return false }
    network_copy(output, 0 as usize, n.routerMac as usize, 0 as usize, 6 as usize)
    return true
}
function network_icmp_echo(n: *Network): bool {
    if !n.online || n.gateway == (0 as u32) { return false }
    if !network_ipv4(n, n.routerMac as usize, n.ip, n.gateway, 1 as u8, 16 as usize) { return false }
    network_put(n.frame, 34 as usize, 8 as u8) // echo request
    network_put(n.frame, 35 as usize, 0 as u8)
    network_write16(n.frame, 36 as usize, 0 as u16)
    network_write16(n.frame, 38 as usize, 0x4e51 as u16)
    network_write16(n.frame, 40 as usize, 1 as u16)
    network_write32(n.frame, 42 as usize, 0x4e4f5145 as u32)
    network_write32(n.frame, 46 as usize, 0x52494f53 as u32)
    network_write16(n.frame, 36 as usize, network_checksum(n.frame, 34 as usize, 16 as usize))
    if !network_send(n, n.frame, 50 as usize) { return false }
    let polls: usize = 0 as usize
    while polls < (64 as usize) {
        let length: usize = network_receive(n, n.rx, 2048 as usize, 200000 as usize)
        if length >= (50 as usize) &&
           network_read16(n.rx, 12 as usize) == (2048 as u16) &&
           network_byte(n.rx, 23 as usize) == (1 as u8) &&
           network_read32(n.rx, 26 as usize) == n.gateway &&
           network_read32(n.rx, 30 as usize) == n.ip &&
           network_byte(n.rx, 34 as usize) == (0 as u8) &&
           network_read16(n.rx, 38 as usize) == (0x4e51 as u16) &&
           network_read16(n.rx, 40 as usize) == (1 as u16) {
            return true
        }
        polls = polls + (1 as usize)
    }
    return false
}

// Serial output for dynamic dotted-decimal addresses (no libc printf).
function network_console_char(value: u8): void {
    let spins: usize = 0 as usize
    while ((arch_in8(1021 as u16) as usize) / (32 as usize)) % (2 as usize) == (0 as usize) &&
          spins < (100000 as usize) {
        arch_pause()
        spins = spins + (1 as usize)
    }
    arch_out8(1016 as u16, value)
}
function network_console_octet(value: u8): void {
    let number: u32 = value as u32
    if number >= (100 as u32) {
        network_console_char((48 as u32 + (number / (100 as u32))) as u8)
        number = number % (100 as u32)
        network_console_char((48 as u32 + (number / (10 as u32))) as u8)
    } else if number >= (10 as u32) {
        network_console_char((48 as u32 + (number / (10 as u32))) as u8)
    }
    network_console_char((48 as u32 + (number % (10 as u32))) as u8)
}
function network_console_ip(address: u32): void {
    network_console_octet((address / (16777216 as u32)) as u8)
    network_console_char(46 as u8)
    network_console_octet(((address / (65536 as u32)) % (256 as u32)) as u8)
    network_console_char(46 as u8)
    network_console_octet(((address / (256 as u32)) % (256 as u32)) as u8)
    network_console_char(46 as u8)
    network_console_octet((address % (256 as u32)) as u8)
}
function network_console_status(n: *Network): void {
    if n == null || !n.online {
        serial_write("Network: no configured Ethernet interface\n")
        return
    }
    if n.adapterKind == (2 as u32) {
        serial_write("Network: Intel 82540EM Ethernet linked (IPv4)\nIP: ")
    } else if n.adapterKind == (3 as u32) {
        serial_write("Network: Realtek RTL8139 Ethernet linked (IPv4)\nIP: ")
    } else {
        serial_write("Network: VirtIO Ethernet linked (IPv4)\nIP: ")
    }
    network_console_ip(n.ip)
    serial_write("\nMask: ")
    network_console_ip(n.mask)
    serial_write("\nGateway: ")
    network_console_ip(n.gateway)
    serial_write("\nDNS: ")
    network_console_ip(n.dns)
    serial_write("\n")
}

// Cooperative packet pump. Responds to correctly addressed ARP requests and
// IPv4 ICMP echo while the single-core serial terminal is idle. No socket
// demultiplexer, DHCP renewal timer, background network thread, or firewall.
function network_service_poll(n: *Network): void {
    if n == null || !n.online { return }
    let size: usize = network_receive(n, n.rx, 2048 as usize, 0 as usize)
    if size < (42 as usize) { return }
    if network_read16(n.rx, 12 as usize) == (2054 as u16) &&
       network_read16(n.rx, 14 as usize) == (1 as u16) &&
       network_read16(n.rx, 16 as usize) == (2048 as u16) &&
       network_byte(n.rx, 18 as usize) == (6 as u8) &&
       network_byte(n.rx, 19 as usize) == (4 as u8) &&
       network_read16(n.rx, 20 as usize) == (1 as u16) &&
       network_read32(n.rx, 38 as usize) == n.ip {
        network_ethernet(n, n.rx + (22 as usize), 2054 as u16)
        network_write16(n.frame, 14 as usize, 1 as u16)
        network_write16(n.frame, 16 as usize, 2048 as u16)
        network_put(n.frame, 18 as usize, 6 as u8)
        network_put(n.frame, 19 as usize, 4 as u8)
        network_write16(n.frame, 20 as usize, 2 as u16)
        network_copy(n.frame, 22 as usize, n.mac as usize, 0 as usize, 6 as usize)
        network_write32(n.frame, 28 as usize, n.ip)
        network_copy(n.frame, 32 as usize, n.rx, 22 as usize, 6 as usize)
        network_write32(n.frame, 38 as usize, network_read32(n.rx, 28 as usize))
        network_fill(n.frame, 42 as usize, 18 as usize, 0 as u8)
        network_send(n, n.frame, 60 as usize)
        return
    }
    if network_ipv4_header(n.rx, size, 1 as u8) != (20 as usize) ||
       network_read32(n.rx, 30 as usize) != n.ip { return }
    let total: usize = network_read16(n.rx, 16 as usize) as usize
    if total < (28 as usize) { return }
    let payload: usize = total - (20 as usize)
    if network_byte(n.rx, 34 as usize) != (8 as u8) ||
       network_byte(n.rx, 35 as usize) != (0 as u8) ||
       network_checksum(n.rx, 34 as usize, payload) != (0 as u16) {
        return
    }
    if !network_ipv4(n, n.rx + (6 as usize), n.ip,
                     network_read32(n.rx, 26 as usize), 1 as u8, payload) { return }
    network_copy(n.frame, 34 as usize, n.rx, 34 as usize, payload)
    network_put(n.frame, 34 as usize, 0 as u8)
    network_write16(n.frame, 36 as usize, 0 as u16)
    network_write16(n.frame, 36 as usize,
                    network_checksum(n.frame, 34 as usize, payload))
    network_send(n, n.frame, 34 as usize + payload)
}

// Deterministic, isolated packet validation fixture. This runs without a
// NIC, external DHCP server or public network. No DMA buffer is shared with
// the real network adapter.
function network_packet_fixture_self_test(): bool {
    let rx: usize = arch_alloc_page()
    let state: usize = arch_alloc_page()
    let macPage: usize = arch_alloc_page()
    if rx == (0 as usize) || state == (0 as usize) ||
       macPage == (0 as usize) { return false }
    network_fill(rx, 0 as usize, 512 as usize, 0 as u8)
    network_fill(state, 0 as usize, 4096 as usize, 0 as u8)
    let n: *Network = state as *Network
    n.rx = rx
    n.mac = macPage as *u8
    n.dhcpXid = 0x4e4f5145 as u32
    network_put(macPage, 0 as usize, 82 as u8)
    network_put(macPage, 1 as usize, 84 as u8)
    network_put(macPage, 2 as usize, 0 as u8)
    network_put(macPage, 3 as usize, 18 as u8)
    network_put(macPage, 4 as usize, 52 as u8)
    network_put(macPage, 5 as usize, 86 as u8)
    // Ethernet + IPv4 + UDP + BOOTP + DHCP options, 292 wire bytes.
    network_write16(rx, 12 as usize, 2048 as u16)
    network_put(rx, 14 as usize, 69 as u8)
    network_write16(rx, 16 as usize, 278 as u16)
    network_put(rx, 22 as usize, 64 as u8)
    network_put(rx, 23 as usize, 17 as u8)
    network_write32(rx, 26 as usize, 0x0a000202 as u32)
    network_write32(rx, 30 as usize, 0xffffffff as u32)
    network_write16(rx, 24 as usize, network_checksum(rx, 14 as usize, 20 as usize))
    network_write16(rx, 34 as usize, 67 as u16)
    network_write16(rx, 36 as usize, 68 as u16)
    network_write16(rx, 38 as usize, 258 as u16)
    network_put(rx, 42 as usize, 2 as u8)
    network_put(rx, 43 as usize, 1 as u8)
    network_put(rx, 44 as usize, 6 as u8)
    network_write32(rx, 46 as usize, 0x4e4f5145 as u32)
    network_write32(rx, 58 as usize, 0x0a00020f as u32)
    network_copy(rx, 70 as usize, macPage, 0 as usize, 6 as usize)
    network_write32(rx, 278 as usize, 0x63825363 as u32)
    network_put(rx, 282 as usize, 53 as u8)
    network_put(rx, 283 as usize, 1 as u8)
    network_put(rx, 284 as usize, 2 as u8)
    network_put(rx, 285 as usize, 54 as u8)
    network_put(rx, 286 as usize, 4 as u8)
    network_write32(rx, 287 as usize, 0x0a000202 as u32)
    network_put(rx, 291 as usize, 255 as u8)

    if !network_is_dhcp(n, 292 as usize) ||
       n.dhcpType != (2 as u8) ||
       n.offer != (0x0a00020f as u32) { return false }

    // The DHCP option 53 exists past the newly shortened UDP datagram:
    // its presence in the Ethernet buffer must no longer make this valid.
    network_write16(rx, 38 as usize, 248 as u16)
    if network_is_dhcp(n, 292 as usize) { return false }
    network_write16(rx, 38 as usize, 258 as u16)

    // Require an explicit option terminator, not merely a buffer boundary.
    network_put(rx, 291 as usize, 0 as u8)
    if network_is_dhcp(n, 292 as usize) { return false }
    network_put(rx, 291 as usize, 255 as u8)

    // Reject fragments even if the IPv4 checksum is recomputed correctly.
    network_write16(rx, 20 as usize, 8192 as u16)
    network_write16(rx, 24 as usize, 0 as u16)
    network_write16(rx, 24 as usize, network_checksum(rx, 14 as usize, 20 as usize))
    if network_is_dhcp(n, 292 as usize) { return false }
    network_write16(rx, 20 as usize, 0 as u16)
    network_write16(rx, 24 as usize, 0 as u16)
    network_write16(rx, 24 as usize, network_checksum(rx, 14 as usize, 20 as usize))

    // Reject corrupted IPv4 header even when BOOTP fields still look valid.
    network_put(rx, 22 as usize, 63 as u8)
    if network_is_dhcp(n, 292 as usize) { return false }
    network_put(rx, 22 as usize, 64 as u8)

    // Restore checksum, then check the DHCP client MAC binding.
    network_put(rx, 70 as usize, 1 as u8)
    network_write16(rx, 24 as usize, 0 as u16)
    network_write16(rx, 24 as usize, network_checksum(rx, 14 as usize, 20 as usize))
    if network_is_dhcp(n, 292 as usize) { return false }
    network_put(rx, 70 as usize, 82 as u8)

    return network_is_dhcp(n, 292 as usize)
}

function network_boot_probe(): *Network {
    let virtioLocation: u32 = pci_find_device_location(6900 as u16, 4161 as u16)
    let intelLocation: u32 = pci_find_device_location(32902 as u16, 4110 as u16)
    let realtekLocation: u32 = pci_find_device_location(4332 as u16, 33081 as u16)
    if virtioLocation == (65536 as u32) && intelLocation == (65536 as u32) &&
       realtekLocation == (65536 as u32) {
        serial_write("NoqeriOS: no supported Ethernet NIC; network offline\n")
        return null
    }
    let statePage: usize = arch_alloc_page()
    let driverPage: usize = arch_alloc_page()
    let framePage: usize = arch_alloc_page()
    let receivePage: usize = arch_alloc_page()
    let payloadPage: usize = arch_alloc_page()
    let macPage: usize = arch_alloc_page()
    if statePage == 0 || driverPage == 0 || framePage == 0 ||
       receivePage == 0 || payloadPage == 0 || macPage == 0 {
        serial_write("NoqeriOS: network DMA allocation failed\n")
        return null
    }
    network_fill(statePage, 0 as usize, 4096 as usize, 0 as u8)
    let network: *Network = statePage as *Network
    network.frame = framePage
    network.rx = receivePage
    network.payload = payloadPage
    network.routerMac = macPage as *u8
    let opened: bool = false
    if virtioLocation != (65536 as u32) {
        network.nic = driverPage as *VirtioNet
        opened = virtio_net_open(virtioLocation, network.nic)
        if opened {
            network.adapterKind = 1 as u32
            network.mac = network.nic.mac
            serial_write("NoqeriOS: VirtIO Ethernet DMA RX/TX queues online\n")
        }
    }
    if !opened && intelLocation != (65536 as u32) {
        network.intel = driverPage as *E1000
        opened = e1000_open(intelLocation, network.intel)
        if opened {
            network.adapterKind = 2 as u32
            network.mac = network.intel.mac
            serial_write("NoqeriOS: Intel 82540EM Ethernet DMA RX/TX queues online\n")
        }
    }
    if !opened && realtekLocation != (65536 as u32) {
        network.realtek = driverPage as *Rtl8139
        opened = rtl8139_open(realtekLocation, network.realtek)
        if opened {
            network.adapterKind = 3 as u32
            network.mac = network.realtek.mac
            serial_write("NoqeriOS: Realtek RTL8139 Ethernet DMA RX/TX online\n")
        }
    }
    if !opened {
        serial_write("NoqeriOS: Ethernet hardware initialization failed\n")
        return null
    }

    if !network_dhcp(network) {
        serial_write("NoqeriOS: DHCP lease unavailable; network offline\n")
        network_close(network)
        return null
    }
    serial_write("NoqeriOS: DHCP IPv4 lease acquired\n")
    if network.gateway != (0 as u32) {
        if !network_arp_request(network) {
            // A usable DHCP lease can still provide local-network access
            // even when the router is unavailable. Keep the NIC alive.
            serial_write("NoqeriOS: gateway ARP failed; LAN-only mode\n")
            network.gateway = 0 as u32
        } else {
            serial_write("NoqeriOS: IPv4 gateway ARP resolved (Ethernet connected)\n")
        }
    } else {
        serial_write("NoqeriOS: DHCP lease has no router; LAN-only mode\n")
    }
    network.online = true
    if network_icmp_echo(network) {
        serial_write("NoqeriOS: IPv4 gateway ICMP echo reply received\n")
    } else {
        serial_write("NoqeriOS: gateway ICMP echo not available\n")
    }
    // Retain the configured network state for serial terminal commands.
    // A future network manager must add lease renewal and ingress dispatch.
    return network
}
