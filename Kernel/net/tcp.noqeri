module os.kernel.net.tcp

import "ipv4.noqeri"

// Reusable bounded connection state for a local QEMU TCP regression fixture.
// Supports initial SYN retries, contiguous receive-stream assembly and
// duplicate/out-of-order ACKs. NOT production TCP: fixed fixture port/ISN,
// no timer-driven RTO, flow/congestion control, multiplexer or sockets.
// Never use against untrusted/public servers.
record TcpProbe {
    remote: u32;
    remoteMac: usize;
    port: u16;
    sequence: u32;
    acknowledgement: u32;
    rxBytes: usize;
    connected: bool;
}

function tcp_checksum(n: *Network, tcpLength: usize): u16 {
    let sum: u32 = 0 as u32
    sum = sum + (n.ip / (65536 as u32)) + (n.ip % (65536 as u32))
    // Remote IPv4 is stored in the outgoing header, network byte order.
    let remote: u32 = network_read32(n.frame, 30 as usize)
    sum = sum + (remote / (65536 as u32)) + (remote % (65536 as u32))
    sum = sum + (6 as u32) + (tcpLength as u32)
    let i: usize = 0 as usize
    while i < tcpLength {
        let hi: u32 = network_byte(n.frame, 34 as usize + i) as u32
        let lo: u32 = 0 as u32
        if i + (1 as usize) < tcpLength {
            lo = network_byte(n.frame, 35 as usize + i) as u32
        }
        sum = sum + hi * (256 as u32) + lo
        i = i + (2 as usize)
    }
    while sum > (65535 as u32) {
        sum = (sum % (65536 as u32)) + (sum / (65536 as u32))
    }
    return ((65535 as u32) - sum) as u16
}
function tcp_emit(n: *Network, t: *TcpProbe, flags: u8, payloadLength: usize): bool {
    if payloadLength > (1200 as usize) { return false }
    if !network_ipv4(n, t.remoteMac, n.ip, t.remote, 6 as u8,
                     20 as usize + payloadLength) { return false }
    network_write16(n.frame, 34 as usize, 49152 as u16)
    network_write16(n.frame, 36 as usize, t.port)
    network_write32(n.frame, 38 as usize, t.sequence)
    network_write32(n.frame, 42 as usize, t.acknowledgement)
    network_put(n.frame, 46 as usize, 80 as u8) // header 20 bytes
    network_put(n.frame, 47 as usize, flags)
    network_write16(n.frame, 48 as usize, 4096 as u16)
    network_write16(n.frame, 50 as usize, 0 as u16)
    network_write16(n.frame, 52 as usize, 0 as u16)
    network_copy(n.frame, 54 as usize, n.payload, 0 as usize, payloadLength)
    network_write16(n.frame, 50 as usize,
                    tcp_checksum(n, (20 as usize) + payloadLength))
    return network_send(n, n.frame, (54 as usize) + payloadLength)
}
// Validate an exact 4-tuple, basic IPv4 framing, TCP checksum, and bounds.
// Returns the packet's TCP header offset, 0 if invalid.
function tcp_receive_valid(n: *Network, t: *TcpProbe, bytes: usize): usize {
    if bytes < (54 as usize) || bytes > (1514 as usize) ||
       network_read16(n.rx, 12 as usize) != (2048 as u16) ||
       network_byte(n.rx, 14 as usize) != (69 as u8) ||
       network_byte(n.rx, 23 as usize) != (6 as u8) ||
       network_read32(n.rx, 26 as usize) != t.remote ||
       network_read32(n.rx, 30 as usize) != n.ip ||
       network_read16(n.rx, 34 as usize) != t.port ||
       network_read16(n.rx, 36 as usize) != (49152 as u16) {
        return 0 as usize
    }
    // Reject corrupt IPv4 header checksums before trusting TCP metadata.
    if network_checksum(n.rx, 14 as usize, 20 as usize) != (0 as u16) {
        return 0 as usize
    }
    let ipLength: usize = network_read16(n.rx, 16 as usize) as usize
    if ipLength < (40 as usize) || ipLength > bytes - (14 as usize) ||
       network_read16(n.rx, 20 as usize) % (8192 as u16) != (0 as u16) {
        return 0 as usize
    }
    let segment: usize = ipLength - (20 as usize)
    if segment < (20 as usize) || segment > (1460 as usize) {
        return 0 as usize
    }
    let headerSize: usize = ((network_byte(n.rx, 46 as usize) as usize) / (16 as usize)) * (4 as usize)
    if headerSize < (20 as usize) || headerSize > segment { return 0 as usize }
    let i: usize = 0 as usize
    let sum: u32 = (t.remote / (65536 as u32)) + (t.remote % (65536 as u32)) +
                   (n.ip / (65536 as u32)) + (n.ip % (65536 as u32)) +
                   (6 as u32) + (segment as u32)
    while i < segment {
        let high: u32 = network_byte(n.rx, (34 as usize) + i) as u32
        let low: u32 = 0 as u32
        if i + (1 as usize) < segment { low = network_byte(n.rx, (35 as usize) + i) as u32 }
        sum = sum + high * (256 as u32) + low
        i = i + (2 as usize)
    }
    while sum > (65535 as u32) {
        sum = (sum % (65536 as u32)) + (sum / (65536 as u32))
    }
    if sum != (65535 as u32) { return 0 as usize }
    return (34 as usize) + headerSize
}
function tcp_poll(n: *Network, t: *TcpProbe, tries: usize): usize {
    let count: usize = 0 as usize
    while count < tries {
        let bytes: usize = network_receive(n, n.rx,
                                           2048 as usize, 150000 as usize)
        let offset: usize = tcp_receive_valid(n, t, bytes)
        if offset != (0 as usize) { return offset }
        count = count + (1 as usize)
    }
    return 0 as usize
}
// Caller owns the network and the connection record. No pointer to the
// caller's stack escapes, matching Noqeri's lifetime checker semantics.
// Only a fixed local fixture is admitted until secure source-port/ISN
// generation and a general TCP manager exist.
function tcp_fixture_open(n: *Network, t: *TcpProbe, dropFirstSyn: bool): bool {
    if n == null || !n.online || t == null { return false }
    if n.gateway != (0x0a000202 as u32) { return false }
    let mac: usize = n.frame + (2048 as usize)
    if !network_route_mac(n, 0x0a000202 as u32, mac) { return false }
    t.remote = 0x0a000202 as u32
    t.remoteMac = mac
    t.port = 18080 as u16
    t.sequence = 0x4e515043 as u32
    t.acknowledgement = 0 as u32
    t.rxBytes = 0 as usize
    t.connected = false

    // Fault-injection mode deliberately suppresses attempt 1 to exercise
    // bounded SYN retry without exposing the fixture to an external network.
    let attempt: usize = 0 as usize
    while attempt < (3 as usize) && !t.connected {
        if !dropFirstSyn || attempt != (0 as usize) {
            if !tcp_emit(n, t, 2 as u8, 0 as usize) { return false }
            let offset: usize = tcp_poll(n, t, 64 as usize)
            if offset != (0 as usize) {
                let flags: u8 = network_byte(n.rx, 47 as usize)
                if ((flags as u32) / (4 as u32)) % (2 as u32) == (0 as u32) &&
                   ((flags as u32) / (2 as u32)) % (2 as u32) == (1 as u32) &&
                   ((flags as u32) / (16 as u32)) % (2 as u32) == (1 as u32) &&
                   network_read32(n.rx, 42 as usize) == t.sequence + (1 as u32) {
                    t.acknowledgement = network_read32(n.rx, 38 as usize) + (1 as u32)
                    t.sequence = t.sequence + (1 as u32)
                    t.connected = true
                }
            }
        }
        attempt = attempt + (1 as usize)
    }
    if !t.connected { return false }
    return tcp_emit(n, t, 16 as u8, 0 as usize)
}

// Accept only contiguous response bytes in a 1024-byte bounded receive
// scratchpad, on the second half of the network RX page. Duplicate and
// out-of-order segments trigger duplicate ACKs without corrupting the stream.
function tcp_fixture_accept(n: *Network, t: *TcpProbe, offset: usize): bool {
    let ipTotal: usize = network_read16(n.rx, 16 as usize) as usize
    let end: usize = (14 as usize) + ipTotal
    if end < offset || end > (1514 as usize) { return false }
    let flags: u8 = network_byte(n.rx, 47 as usize)
    if ((flags as u32) / (4 as u32)) % (2 as u32) == (1 as u32) {
        return false // peer RST; never trust a payload with it
    }
    if ((flags as u32) / (16 as u32)) % (2 as u32) == (0 as u32) {
        return false // no ACK
    }
    if network_read32(n.rx, 42 as usize) != t.sequence { return false }
    let dataLength: usize = end - offset
    let peerSeq: u32 = network_read32(n.rx, 38 as usize)
    if dataLength > (0 as usize) {
        if peerSeq == t.acknowledgement &&
           dataLength <= (1024 as usize) - t.rxBytes {
            network_copy(n.rx + (2048 as usize), t.rxBytes,
                         n.rx, offset, dataLength)
            t.rxBytes = t.rxBytes + dataLength
            t.acknowledgement = t.acknowledgement + (dataLength as u32)
        }
        // An ACK for an out-of-order or repeated segment advertises
        // only bytes actually accepted in the contiguous receive window.
        tcp_emit(n, t, 16 as u8, 0 as usize)
    }
    // The marker may span several TCP segments. Search the assembled
    // stream only, not the Ethernet payload/header or unrelated packets.
    let cursor: usize = 0 as usize
    let scratch: usize = n.rx + (2048 as usize)
    while cursor + (13 as usize) <= t.rxBytes {
        if network_byte(scratch, cursor) == (78 as u8) &&
           network_byte(scratch, cursor + (1 as usize)) == (79 as u8) &&
           network_byte(scratch, cursor + (2 as usize)) == (81 as u8) &&
           network_byte(scratch, cursor + (3 as usize)) == (69 as u8) &&
           network_byte(scratch, cursor + (4 as usize)) == (82 as u8) &&
           network_byte(scratch, cursor + (5 as usize)) == (73 as u8) &&
           network_byte(scratch, cursor + (6 as usize)) == (95 as u8) &&
           network_byte(scratch, cursor + (7 as usize)) == (78 as u8) &&
           network_byte(scratch, cursor + (8 as usize)) == (69 as u8) &&
           network_byte(scratch, cursor + (9 as usize)) == (84 as u8) &&
           network_byte(scratch, cursor + (10 as usize)) == (95 as u8) &&
           network_byte(scratch, cursor + (11 as usize)) == (79 as u8) &&
           network_byte(scratch, cursor + (12 as usize)) == (75 as u8) {
            return true
        }
        cursor = cursor + (1 as usize)
    }
    return false
}

function tcp_fixture_request(n: *Network, dropFirstSyn: bool): bool {
    if n == null || !n.online { return false }
    // The outgoing frame page is 4 KiB, and L2 packets occupy at most 1514
    // bytes. Reuse reserved scratch bytes to avoid leaking a physical page
    // on every terminal probe. Do not let this address escape the command.
    let t: *TcpProbe = (n.frame + (3072 as usize)) as *TcpProbe
    if !tcp_fixture_open(n, t, dropFirstSyn) { return false }
    network_fill(n.rx + (2048 as usize), 0 as usize, 1024 as usize, 0 as u8)

    // GET / HTTP/1.0, no hostname resolution or TLS. Local test only.
    // The payload is deliberately constructed from bounded bytes rather
    // than relying on runtime string interop in the freestanding compiler.
    network_fill(n.payload, 0 as usize, 32 as usize, 0 as u8)
    network_put(n.payload, 0 as usize, 71 as u8)
    network_put(n.payload, 1 as usize, 69 as u8)
    network_put(n.payload, 2 as usize, 84 as u8)
    network_put(n.payload, 3 as usize, 32 as u8)
    network_put(n.payload, 4 as usize, 47 as u8)
    network_put(n.payload, 5 as usize, 32 as u8)
    network_put(n.payload, 6 as usize, 72 as u8)
    network_put(n.payload, 7 as usize, 84 as u8)
    network_put(n.payload, 8 as usize, 84 as u8)
    network_put(n.payload, 9 as usize, 80 as u8)
    network_put(n.payload, 10 as usize, 47 as u8)
    network_put(n.payload, 11 as usize, 49 as u8)
    network_put(n.payload, 12 as usize, 46 as u8)
    network_put(n.payload, 13 as usize, 48 as u8)
    network_put(n.payload, 14 as usize, 13 as u8)
    network_put(n.payload, 15 as usize, 10 as u8)
    network_put(n.payload, 16 as usize, 13 as u8)
    network_put(n.payload, 17 as usize, 10 as u8)
    if !tcp_emit(n, t, 24 as u8, 18 as usize) { return false }
    t.sequence = t.sequence + (18 as u32)

    let response: bool = false
    let polls: usize = 0 as usize
    while polls < (128 as usize) && !response {
        let length: usize = network_receive(n, n.rx, 2048 as usize, 150000 as usize)
        let offset: usize = tcp_receive_valid(n, t, length)
        if offset != (0 as usize) {
            response = tcp_fixture_accept(n, t, offset)
        }
        polls = polls + (1 as usize)
    }
    // Tear down with a local RST rather than leave a half-open guest socket.
    tcp_emit(n, t, 20 as u8, 0 as usize)
    return response
}
