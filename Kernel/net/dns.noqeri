module os.kernel.net.dns

import "ipv4.noqeri"

// Bounded DNS client for one IPv4 A record and one fixed hostname.
// No DNSSEC, caching, recursion, TCP fallback or general resolver yet.
// The routine never treats compressed DNS names as arbitrary pointers.
function dns_skip_name(packet: usize, start: usize, limit: usize): usize {
    let offset: usize = start
    let labels: usize = 0 as usize
    while offset < limit && labels < (64 as usize) {
        let length: usize = network_byte(packet, offset) as usize
        if length == (0 as usize) { return offset + (1 as usize) }
        if length >= (192 as usize) {
            if offset + (2 as usize) > limit { return 0 as usize }
            return offset + (2 as usize)
        }
        if length > (63 as usize) || length > (limit - offset - (1 as usize)) {
            return 0 as usize
        }
        offset = offset + (1 as usize) + length
        labels = labels + (1 as usize)
    }
    return 0 as usize
}

// A complete Ethernet IPv4 UDP DNS reply, with a checked transaction ID,
// endpoint tuple, packet lengths and bounded question/answer traversal.
// Returns 0 when malformed, unsupported, absent or untrusted.
function dns_parse_a(frame: usize, length: usize, dnsServer: u32): u32 {
    if length < (14 as usize + 20 as usize + 8 as usize + 12 as usize) ||
       length > (1514 as usize) { return 0 as u32 }
    if network_read16(frame, 12 as usize) != (2048 as u16) ||
       network_byte(frame, 14 as usize) != (69 as u8) ||
       network_byte(frame, 23 as usize) != (17 as u8) ||
       network_read32(frame, 26 as usize) != dnsServer { return 0 as u32 }
    let ipLength: usize = network_read16(frame, 16 as usize) as usize
    if ipLength < (40 as usize) || ipLength > length - (14 as usize) { return 0 as u32 }
    // Ignore fragmented UDP datagrams.
    if (network_read16(frame, 20 as usize) % (8192 as u16)) != (0 as u16) { return 0 as u32 }
    if network_read16(frame, 34 as usize) != (53 as u16) ||
       network_read16(frame, 36 as usize) != (53000 as u16) { return 0 as u32 }
    let udpLength: usize = network_read16(frame, 38 as usize) as usize
    if udpLength < (20 as usize) || udpLength > ipLength - (20 as usize) {
        return 0 as u32
    }
    let base: usize = 42 as usize
    let end: usize = base + udpLength - (8 as usize)
    if end > length || network_read16(frame, base) != (0x4e51 as u16) ||
       network_read16(frame, base + (2 as usize)) != (0x8180 as u16) ||
       network_read16(frame, base + (4 as usize)) != (1 as u16) { return 0 as u32 }
    let answers: usize = network_read16(frame, base + (6 as usize)) as usize
    if answers == (0 as usize) || answers > (32 as usize) { return 0 as u32 }
    let cursor: usize = dns_skip_name(frame, base + (12 as usize), end)
    if cursor == (0 as usize) || cursor > end ||
       end - cursor < (4 as usize) { return 0 as u32 }
    if network_read16(frame, cursor) != (1 as u16) ||
       network_read16(frame, cursor + (2 as usize)) != (1 as u16) { return 0 as u32 }
    cursor = cursor + (4 as usize)
    let i: usize = 0 as usize
    while i < answers {
        let next: usize = dns_skip_name(frame, cursor, end)
        if next == (0 as usize) || next > end || end - next < (10 as usize) {
            return 0 as u32
        }
        let kind: u16 = network_read16(frame, next)
        let class: u16 = network_read16(frame, next + (2 as usize))
        let dataLength: usize = network_read16(frame, next + (8 as usize)) as usize
        let payload: usize = next + (10 as usize)
        if payload > end || dataLength > end - payload { return 0 as u32 }
        if kind == (1 as u16) && class == (1 as u16) &&
           dataLength == (4 as usize) {
            return network_read32(frame, payload)
        }
        cursor = payload + dataLength
        i = i + (1 as usize)
    }
    return 0 as u32
}
// Deterministic offline regression: valid A answer, wrong transaction,
// foreign DNS server and truncated packet must not be accepted.
function dns_fixture_self_test(): bool {
    let frame: usize = arch_alloc_page()
    if frame == (0 as usize) { return false }
    network_fill(frame, 0 as usize, 128 as usize, 0 as u8)
    network_write16(frame, 12 as usize, 2048 as u16)
    network_put(frame, 14 as usize, 69 as u8)
    network_put(frame, 23 as usize, 17 as u8)
    network_write16(frame, 16 as usize, 73 as u16)
    network_write32(frame, 26 as usize, 0x0a000203 as u32)
    network_write16(frame, 34 as usize, 53 as u16)
    network_write16(frame, 36 as usize, 53000 as u16)
    network_write16(frame, 38 as usize, 53 as u16)
    network_write16(frame, 42 as usize, 0x4e51 as u16)
    network_write16(frame, 44 as usize, 0x8180 as u16)
    network_write16(frame, 46 as usize, 1 as u16)
    network_write16(frame, 48 as usize, 1 as u16)
    network_put(frame, 54 as usize, 7 as u8)
    network_put(frame, 55 as usize, 101 as u8)
    network_put(frame, 56 as usize, 120 as u8)
    network_put(frame, 57 as usize, 97 as u8)
    network_put(frame, 58 as usize, 109 as u8)
    network_put(frame, 59 as usize, 112 as u8)
    network_put(frame, 60 as usize, 108 as u8)
    network_put(frame, 61 as usize, 101 as u8)
    network_put(frame, 62 as usize, 3 as u8)
    network_put(frame, 63 as usize, 99 as u8)
    network_put(frame, 64 as usize, 111 as u8)
    network_put(frame, 65 as usize, 109 as u8)
    network_put(frame, 66 as usize, 0 as u8)
    network_write16(frame, 67 as usize, 1 as u16)
    network_write16(frame, 69 as usize, 1 as u16)
    network_put(frame, 71 as usize, 192 as u8)
    network_put(frame, 72 as usize, 12 as u8)
    network_write16(frame, 73 as usize, 1 as u16)
    network_write16(frame, 75 as usize, 1 as u16)
    network_write32(frame, 77 as usize, 60 as u32)
    network_write16(frame, 81 as usize, 4 as u16)
    network_write32(frame, 83 as usize, 0xcb007107 as u32)
    if dns_parse_a(frame, 87 as usize, 0x0a000203 as u32) != (0xcb007107 as u32) {
        return false
    }
    if dns_parse_a(frame, 86 as usize, 0x0a000203 as u32) != (0 as u32) {
        return false
    }
    if dns_parse_a(frame, 87 as usize, 0x0a000204 as u32) != (0 as u32) {
        return false
    }
    network_write16(frame, 42 as usize, 0x0000 as u16)
    return dns_parse_a(frame, 87 as usize, 0x0a000203 as u32) == (0 as u32)
}

function network_dns_example(n: *Network): u32 {
    if n == null || !n.online || n.dns == (0 as u32) { return 0 as u32 }
    // DNS wire header: query ID 'NQ', recursion desired, QDCOUNT=1.
    network_fill(n.payload, 0 as usize, 64 as usize, 0 as u8)
    network_write16(n.payload, 0 as usize, 0x4e51 as u16)
    network_write16(n.payload, 2 as usize, 0x0100 as u16)
    network_write16(n.payload, 4 as usize, 1 as u16)
    // "example.com" in uncompressed QNAME encoding.
    network_put(n.payload, 12 as usize, 7 as u8)
    let name: usize = n.payload
    network_put(name, 13 as usize, 101 as u8)
    network_put(name, 14 as usize, 120 as u8)
    network_put(name, 15 as usize, 97 as u8)
    network_put(name, 16 as usize, 109 as u8)
    network_put(name, 17 as usize, 112 as u8)
    network_put(name, 18 as usize, 108 as u8)
    network_put(name, 19 as usize, 101 as u8)
    network_put(name, 20 as usize, 3 as u8)
    network_put(name, 21 as usize, 99 as u8)
    network_put(name, 22 as usize, 111 as u8)
    network_put(name, 23 as usize, 109 as u8)
    network_put(name, 24 as usize, 0 as u8)
    network_write16(name, 25 as usize, 1 as u16)
    network_write16(name, 27 as usize, 1 as u16)
    let destinationMac: usize = n.frame + (2048 as usize)
    if !network_route_mac(n, n.dns, destinationMac) { return 0 as u32 }
    if !network_udp_send(n, destinationMac, n.dns,
                         53000 as u16, 53 as u16, 29 as usize) { return 0 as u32 }
    let count: usize = 0 as usize
    while count < (64 as usize) {
        let bytes: usize = network_receive(n, n.rx, 2048 as usize, 200000 as usize)
        if bytes > (0 as usize) {
            let found: u32 = dns_parse_a(n.rx, bytes, n.dns)
            if found != (0 as u32) { return found }
        }
        count = count + (1 as usize)
    }
    return 0 as u32
}
