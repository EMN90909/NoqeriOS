function gui_panel(g: *GuiDesktop, x: usize, y: usize,
                   w: usize, h: usize, title: u32): void {
    let active: bool = (title == (1 as u32) && g.focused == (0 as usize)) ||
                       (title == (2 as u32) && g.focused == (1 as usize))
    gui_fill(g, x + (5 as usize), y + (6 as usize), w, h, 0x0d1121 as u32)
    gui_fill(g, x, y, w, h, 0x202d44 as u32)
    let edge: u32 = 0x465775 as u32
    if active { edge = 0x58d6d0 as u32 }
    gui_fill(g, x, y, w, 3 as usize, edge)
    gui_fill(g, x, y, 3 as usize, h, edge)
    gui_fill(g, x + w - (3 as usize), y, 3 as usize, h, edge)
    gui_fill(g, x, y + h - (3 as usize), w, 3 as usize, edge)
    gui_fill(g, x + (3 as usize), y + (3 as usize),
             w - (6 as usize), 36 as usize, 0x131e33 as u32)
    gui_label(g, title, x + (14 as usize), y + (13 as usize), 0xf1f5fc as u32)
    gui_fill(g, x + w - (25 as usize), y + (17 as usize),
             8 as usize, 8 as usize, edge)
}
function gui_paint(g: *GuiDesktop): void {
    if g == null { return }
    // Compose retained layers: wallpaper, top bar, overlapping windows,
    // selection highlight and persistent bottom shortcut dock.
    gui_fill(g, 0 as usize, 0 as usize, g.width, g.height, 0x101728 as u32)
    let y: usize = 0 as usize
    while y < g.height {
        if y % (76 as usize) < (2 as usize) {
            gui_fill(g, 0 as usize, y, g.width, 2 as usize, 0x18243a as u32)
        }
        y = y + (1 as usize)
    }
    gui_fill(g, 0 as usize, 0 as usize, g.width, 55 as usize, 0x0c1426 as u32)
    gui_fill(g, 0 as usize, 52 as usize, g.width, 3 as usize, 0x58d6d0 as u32)
    gui_label(g, 3 as u32, 24 as usize, 18 as usize, 0xffffff as u32)
    if g.width >= (650 as usize) {
        gui_label(g, 4 as u32, g.width - (302 as usize),
                  19 as usize, 0x9caec6 as u32)
    }

    let left: usize = 30 as usize
    let top: usize = 85 as usize
    let panelW: usize = 350 as usize
    let panelH: usize = 240 as usize
    if panelW > g.width - (44 as usize) { panelW = g.width - (44 as usize) }
    if panelH > g.height - (125 as usize) { panelH = g.height - (125 as usize) }
    let secondX: usize = 160 as usize
    let secondY: usize = 146 as usize
    if secondX + panelW > g.width - (12 as usize) {
        secondX = g.width - panelW - (12 as usize)
    }
    if secondY + panelH > g.height - (56 as usize) {
        secondY = g.height - panelH - (56 as usize)
    }
    if g.focused == (0 as usize) {
        gui_panel(g, secondX, secondY, panelW, panelH, 2 as u32)
        gui_panel(g, left, top, panelW, panelH, 1 as u32)
    } else {
        gui_panel(g, left, top, panelW, panelH, 1 as u32)
        gui_panel(g, secondX, secondY, panelW, panelH, 2 as u32)
    }
    if g.focused == (0 as usize) {
        gui_label(g, 5 as u32, left + (18 as usize),
                  top + (57 as usize), 0xf2f7ff as u32)
        gui_label(g, 6 as u32, left + (18 as usize),
                  top + (91 as usize), 0x9ab2ce as u32)
        gui_label(g, 7 as u32, left + (18 as usize),
                  top + (119 as usize), 0x9ab2ce as u32)
        gui_label(g, 8 as u32, left + (18 as usize),
                  top + (151 as usize), 0x58d6d0 as u32)
    } else {
        gui_label(g, 9 as u32, secondX + (18 as usize),
                  secondY + (57 as usize), 0xf2f7ff as u32)
        gui_label(g, 10 as u32, secondX + (18 as usize),
                  secondY + (90 as usize), 0xf6c779 as u32)
        gui_label(g, 11 as u32, secondX + (18 as usize),
                  secondY + (121 as usize), 0x58d6d0 as u32)
        gui_label(g, 12 as u32, secondX + (18 as usize),
                  secondY + (151 as usize), 0x9ab2ce as u32)
    }
    let barY: usize = g.height - (45 as usize)
    gui_fill(g, 0 as usize, barY, g.width, 45 as usize, 0x0c1426 as u32)
    gui_fill(g, 20 as usize, barY + (10 as usize), 145 as usize,
             27 as usize, 0x2a6672 as u32)
    gui_label(g, 13 as u32, 36 as usize, barY + (17 as usize), 0xffffff as u32)
    if g.width >= (500 as usize) {
        gui_label(g, 14 as u32, 185 as usize,
                  barY + (17 as usize), 0xaec4db as u32)
    }
    if g.explorerVisible && g.width >= (520 as usize) && g.height >= (360 as usize) { explorer_paint(g) }
    g.redraws = g.redraws + (1 as usize)
}
function gui_open(info: usize): *GuiDesktop {
    let tag: usize = mb2_find_framebuffer(info)
    if tag == (0 as usize) { return null }
    let fb: *Mb2FramebufferTag = tag as *Mb2FramebufferTag
    if fb.bpp != (32 as u8) || fb.framebufferType != (1 as u8) ||
       fb.width < (320 as u32) || fb.height < (240 as u32) ||
       fb.width > (4096 as u32) || fb.height > (2160 as u32) ||
       fb.pitch < fb.width * (4 as u32) ||
       fb.pitch % (4 as u32) != (0 as u32) ||
       fb.address == (0 as u64) { return null }
    let state: usize = arch_alloc_page()
    if state == (0 as usize) { return null }
    let g: *GuiDesktop = state as *GuiDesktop
    g.pixels = (fb.address as usize) as *volatile u32
    g.width = fb.width as usize
    g.height = fb.height as usize
    g.stride = (fb.pitch as usize) / (4 as usize)
    g.swapRedBlue = false
    // RGB framebuffer channel positions are in tag offsets 32-37.
    if fb.size >= (38 as u32) {
        let channels: *u8 = (tag + (32 as usize)) as *u8
        // GOP RGB encoding has red in the least significant byte.
        g.swapRedBlue = channels[0] == (0 as u8) &&
                        channels[4] == (16 as u8)
    }
    g.focused = 0 as usize
    g.selectedAction = 0 as usize
    g.redraws = 0 as usize
    g.explorerVisible = false
    g.explorer = null
    gui_paint(g)
    return g
}
function gui_key(g: *GuiDesktop, key: u8): bool {
    if g == null { return false }
    let changed: bool = false
    if key == (102 as u8) || key == (70 as u8) {
        g.explorerVisible = !g.explorerVisible
        changed = true
    } else if g.explorerVisible && g.explorer != null && (key == (106 as u8) || key == (74 as u8)) {
        files_select_next(g.explorer)
        changed = true
    } else if g.explorerVisible && g.explorer != null && (key == (107 as u8) || key == (75 as u8)) {
        files_select_previous(g.explorer)
        changed = true
    } else if g.explorerVisible && g.explorer != null && (key == (101 as u8) || key == (69 as u8)) {
        files_enter(g.explorer)
        changed = true
    } else if g.explorerVisible && g.explorer != null && (key == (98 as u8) || key == (66 as u8)) {
        files_back(g.explorer)
        changed = true
    } else if key == (97 as u8) || key == (65 as u8) {
        g.focused = 0 as usize
        changed = true
    } else if key == (115 as u8) || key == (83 as u8) {
        g.focused = 1 as usize
        changed = true
    } else if key == (122 as u8) || key == (90 as u8) {
        g.selectedAction = g.selectedAction + (1 as usize)
        g.focused = (g.focused + (1 as usize)) % (2 as usize)
        changed = true
    }
    if changed {
        gui_paint(g)
        serial_write("NoqeriOS: GUI compositor window focus updated\n")
    }
    return changed
}
// Optional legacy i8042 keyboard input. No assumption of a USB keyboard.
// QEMU PS/2 set-1 make codes: A=0x1e S=0x1f Z=0x2c Enter=0x1c.
// Drain AUX/mouse packets but do not attempt to interpret them as keys.
function gui_keyboard_poll(g: *GuiDesktop): void {
    if g == null { return }
    let status: u8 = arch_in8(100 as u16)
    if status % (2 as u8) != (1 as u8) { return }
    let code: u8 = arch_in8(96 as u16)
    if ((status as u32) / (32 as u32)) % (2 as u32) == (1 as u32) {
        return
    }
    if code == (33 as u8) { gui_key(g, 102 as u8) }
    if code == (36 as u8) { gui_key(g, 106 as u8) }
    if code == (37 as u8) { gui_key(g, 107 as u8) }
    if code == (18 as u8) || code == (28 as u8) { gui_key(g, 101 as u8) }
    if code == (48 as u8) || code == (14 as u8) { gui_key(g, 98 as u8) }
    if code == (30 as u8) { gui_key(g, 97 as u8) }
    if code == (31 as u8) { gui_key(g, 115 as u8) }
    if code == (44 as u8) { gui_key(g, 122 as u8) }
}

// File Explorer prototype: native framebuffer, no fabricated filesystem names.
function explorer_label_0(g: *GuiDesktop, x: usize, y: usize, color: u32): void {
    gui_letter(g, 70 as u8, x + (0 as usize), y, color)
    gui_letter(g, 73 as u8, x + (12 as usize), y, color)
    gui_letter(g, 76 as u8, x + (24 as usize), y, color)
    gui_letter(g, 69 as u8, x + (36 as usize), y, color)
    gui_letter(g, 83 as u8, x + (48 as usize), y, color)
}
