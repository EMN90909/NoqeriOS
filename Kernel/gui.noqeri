module os.kernel.gui

import "../Arch/x86_64/api.noqeri"
import "../Drivers/serial.noqeri"
import "../Drivers/framebuffer.noqeri"
import "file_manager.noqeri"

// Initial single-process layered software compositor. UI surfaces are
// rectangles/text redrawn into GOP/MB2 framebuffer on selection changes.
// No GPU acceleration, mouse cursor, USB HID or userspace window IPC yet.
record GuiDesktop {
    pixels: *volatile u32;
    width: usize;
    height: usize;
    stride: usize;
    swapRedBlue: bool;
    focused: usize;
    selectedAction: usize;
    redraws: usize;
    explorerVisible: bool;
    explorer: *FileManager;
}

function gui_color(g: *GuiDesktop, rgb: u32): u32 {
    if !g.swapRedBlue { return rgb }
    let red: u32 = rgb / (65536 as u32)
    let green: u32 = (rgb / (256 as u32)) % (256 as u32)
    let blue: u32 = rgb % (256 as u32)
    return blue * (65536 as u32) + green * (256 as u32) + red
}
function gui_fill(g: *GuiDesktop, left: usize, top: usize,
                  width: usize, height: usize, color: u32): void {
    if g == null || left >= g.width || top >= g.height { return }
    let w: usize = width
    let h: usize = height
    if w > g.width - left { w = g.width - left }
    if h > g.height - top { h = g.height - top }
    let packed: u32 = gui_color(g, color)
    let y: usize = 0 as usize
    while y < h {
        let row: usize = (top + y) * g.stride + left
        let x: usize = 0 as usize
        while x < w {
            g.pixels[row + x] = packed
            x = x + (1 as usize)
        }
        y = y + (1 as usize)
    }
}
function gui_glyph(code: u8): u64 {
    if code == (48 as u8) { return 15629735534 as u64 }
    if code == (49 as u8) { return 15170933124 as u64 }
    if code == (50 as u8) { return 33558693422 as u64 }
    if code == (51 as u8) { return 32247317566 as u64 }
    if code == (52 as u8) { return 2247698626 as u64 }
    if code == (53 as u8) { return 32247857695 as u64 }
    if code == (54 as u8) { return 15621636359 as u64 }
    if code == (55 as u8) { return 8866891839 as u64 }
    if code == (56 as u8) { return 15621113390 as u64 }
    if code == (57 as u8) { return 30133437998 as u64 }
    if code == (65 as u8) { return 18842895918 as u64 }
    if code == (66 as u8) { return 32801506878 as u64 }
    if code == (67 as u8) { return 16660316687 as u64 }
    if code == (68 as u8) { return 32801080894 as u64 }
    if code == (69 as u8) { return 33840644639 as u64 }
    if code == (70 as u8) { return 17734517279 as u64 }
    if code == (71 as u8) { return 16695149071 as u64 }
    if code == (72 as u8) { return 18842895921 as u64 }
    if code == (73 as u8) { return 33424543903 as u64 }
    if code == (74 as u8) { return 13507823687 as u64 }
    if code == (75 as u8) { return 18879369809 as u64 }
    if code == (76 as u8) { return 33840185872 as u64 }
    if code == (77 as u8) { return 18842572657 as u64 }
    if code == (78 as u8) { return 18842507057 as u64 }
    if code == (79 as u8) { return 15621211694 as u64 }
    if code == (80 as u8) { return 17734518334 as u64 }
    if code == (81 as u8) { return 14585218606 as u64 }
    if code == (82 as u8) { return 18879563326 as u64 }
    if code == (83 as u8) { return 32247333391 as u64 }
    if code == (84 as u8) { return 4433514655 as u64 }
    if code == (85 as u8) { return 15621211697 as u64 }
    if code == (86 as u8) { return 4648912433 as u64 }
    if code == (87 as u8) { return 11464787505 as u64 }
    if code == (88 as u8) { return 18834663985 as u64 }
    if code == (89 as u8) { return 4433521201 as u64 }
    if code == (90 as u8) { return 33831389247 as u64 }
    if code == (58 as u8) { return 138416256 as u64 }
    if code == (45 as u8) { return 1015808 as u64 }
    if code == (47 as u8) { return 17725261857 as u64 }
    if code == (46 as u8) { return 4429185024 as u64 }
    if code == (32 as u8) { return 0 as u64 }
    if code == (124 as u8) { return 4433514628 as u64 }
    return 0 as u64
}
function gui_letter(g: *GuiDesktop, code: u8, x: usize, y: usize, color: u32): void {
    let shape: u64 = gui_glyph(code)
    let row: usize = 0 as usize
    while row < (7 as usize) {
        let divisor: u64 = 1 as u64
        let j: usize = 0 as usize
        while j < row {
            divisor = divisor * (32 as u64)
            j = j + (1 as usize)
        }
        let bits: u64 = (shape / divisor) % (32 as u64)
        let col: usize = 0 as usize
        while col < (5 as usize) {
            let mask: u64 = 16 as u64
            let c: usize = 0 as usize
            while c < col {
                mask = mask / (2 as u64)
                c = c + (1 as usize)
            }
            if (bits / mask) % (2 as u64) == (1 as u64) {
                gui_fill(g, x + col * (2 as usize), y + row * (2 as usize),
                         2 as usize, 2 as usize, color)
            }
            col = col + (1 as usize)
        }
        row = row + (1 as usize)
    }
}
// Static, precompiled labels avoid unsupported freestanding string-pointer casts.
function gui_label(g: *GuiDesktop, labelId: u32, x: usize, y: usize, color: u32): void {
    if labelId == (1 as u32) {
        gui_letter(g, 87 as u8, x + (0 as usize), y, color)
        gui_letter(g, 69 as u8, x + (12 as usize), y, color)
        gui_letter(g, 76 as u8, x + (24 as usize), y, color)
        gui_letter(g, 67 as u8, x + (36 as usize), y, color)
        gui_letter(g, 79 as u8, x + (48 as usize), y, color)
