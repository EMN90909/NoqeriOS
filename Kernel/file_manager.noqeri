module os.kernel.file_manager
import "../Arch/x86_64/api.noqeri"
import "../Drivers/serial.noqeri"
import "fs/vfs.noqeri"
import "fs/types.noqeri"

// Read-only, bounded NoqFS explorer. v2 supports 24-byte names and parent
// directory keys; v1 displays synthetic numeric keys via the GUI.
record FileManager {
    mount: *VfsMount;
    count: usize;
    selected: usize;
    currentParent: u64;
    keys: *u64;
    sizes: *u64;
    parents: *u64;
    flags: *u32;
    names: *u8;
    visible: *u32;
    visibleCount: usize;
}

function files_refresh(m: *FileManager): void {
    if m == null { return }
    m.visibleCount = 0 as usize
    let i: usize = 0 as usize
    while i < m.count {
        if m.parents[i] == m.currentParent {
            m.visible[m.visibleCount] = i as u32
            m.visibleCount = m.visibleCount + (1 as usize)
        }
        i = i + (1 as usize)
    }
    if m.selected >= m.visibleCount { m.selected = 0 as usize }
}

function files_open(blockLocation: u32): *FileManager {
    let page: usize = arch_alloc_page()
    let mountPage: usize = arch_alloc_page()
    let keysPage: usize = arch_alloc_page()
    let sizesPage: usize = arch_alloc_page()
    let parentsPage: usize = arch_alloc_page()
    let flagsPage: usize = arch_alloc_page()
    let namesPage: usize = arch_alloc_page()
    let visiblePage: usize = arch_alloc_page()
    let nodePage: usize = arch_alloc_page()
    if page == (0 as usize) || mountPage == (0 as usize) ||
       keysPage == (0 as usize) || sizesPage == (0 as usize) ||
       parentsPage == (0 as usize) || flagsPage == (0 as usize) ||
       namesPage == (0 as usize) || visiblePage == (0 as usize) ||
       nodePage == (0 as usize) { return null }
    let mount: *VfsMount = mountPage as *VfsMount
    if !vfs_mount_noqfs(blockLocation, mount) { return null }
    let m: *FileManager = page as *FileManager
    m.mount = mount
    m.keys = keysPage as *u64
    m.sizes = sizesPage as *u64
    m.parents = parentsPage as *u64
    m.flags = flagsPage as *u32
    m.names = namesPage as *u8
    m.visible = visiblePage as *u32
    m.count = 0 as usize
    m.selected = 0 as usize
    m.currentParent = 0 as u64
    m.visibleCount = 0 as usize
    let node: *VfsNode = nodePage as *VfsNode
    let i: u32 = 0 as u32
    while i < mount.rootEntryCount && m.count < (128 as usize) {
        // 25 bytes per name, 128 entries occupy 3200 bytes.
        let nameAt: usize = namesPage + (m.count * (25 as usize))
        if vfs_entry_at(mountPage, i, nodePage, nameAt) {
            m.keys[m.count] = node.key
            m.sizes[m.count] = node.size
            m.parents[m.count] = node.parentKey
            m.flags[m.count] = node.flags
            m.count = m.count + (1 as usize)
        }
        i = i + (1 as u32)
    }
    files_refresh(m)
    serial_write("NoqeriOS: named NoqFS explorer ready (read-only)\n")
    return m
}

function files_select_next(m: *FileManager): void {
    if m == null || m.visibleCount == (0 as usize) { return }
    m.selected = (m.selected + (1 as usize)) % m.visibleCount
}
function files_select_previous(m: *FileManager): void {
    if m == null || m.visibleCount == (0 as usize) { return }
    if m.selected == (0 as usize) { m.selected = m.visibleCount - (1 as usize) }
    else { m.selected = m.selected - (1 as usize) }
}
function files_enter(m: *FileManager): bool {
    if m == null || m.selected >= m.visibleCount { return false }
    let index: usize = m.visible[m.selected] as usize
    if m.flags[index] != (2 as u32) { return false }
    m.currentParent = m.keys[index]
    m.selected = 0 as usize
    files_refresh(m)
    return true
}
function files_back(m: *FileManager): bool {
    if m == null || m.currentParent == (0 as u64) { return false }
    let nextParent: u64 = 0 as u64
    let i: usize = 0 as usize
    while i < m.count {
        if m.keys[i] == m.currentParent {
            nextParent = m.parents[i]
        }
        i = i + (1 as usize)
    }
    m.currentParent = nextParent
    m.selected = 0 as usize
    files_refresh(m)
    return true
}
function files_read_selected(m: *FileManager, output: usize, capacity: usize): usize {
    if m == null || m.selected >= m.visibleCount || capacity == (0 as usize) { return 0 as usize }
    let index: usize = m.visible[m.selected] as usize
    if m.flags[index] != (1 as u32) { return 0 as usize }
    let nodePage: usize = arch_alloc_page()
    if nodePage == (0 as usize) { return 0 as usize }
    let node: *VfsNode = nodePage as *VfsNode
    if !vfs_open_root_key(m.mount, m.keys[index], node) { return 0 as usize }
    return vfs_read(node, 0 as usize, capacity, output)
}
