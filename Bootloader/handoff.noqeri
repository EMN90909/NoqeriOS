module os.bootloader.handoff

// Pure Noqeri boot information validation. GRUB supplies the Multiboot2
// handoff and the tiny CPU-mode assembly stub calls the kernel entry.
// Caller must ensure the Multiboot2 header resides in mapped memory.
export function boot_info_valid(address: usize): bool {
    if address == (0 as usize) { return false }
    if address % (8 as usize) != (0 as usize) { return false }
    let length: *u32 = address as *u32
    let reserved: *u32 = (address + (4 as usize)) as *u32
    if length[0] < (16 as u32) { return false }
    if length[0] > (1048576 as u32) { return false }
    return reserved[0] == (0 as u32)
}
